script-source,135,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/dict.mjs,import {\n  toTransient as to_transient\x2C\n  fromTransient as from_transient\x2C\n  size\x2C\n  has as has_key\x2C\n  make as new$\x2C\n  get\x2C\n  insert\x2C\n  destructiveTransientInsert as transient_insert\x2C\n  map as map_values\x2C\n  destructiveTransientDelete as transient_delete\x2C\n  fold\x2C\n  destructiveTransientUpdateWith as transient_update_with\x2C\n} from "../dict.mjs";\nimport { Ok\x2C toList\x2C Empty as $Empty\x2C prepend as listPrepend } from "../gleam.mjs";\nimport * as $option from "../gleam/option.mjs";\n\nexport { fold\x2C get\x2C has_key\x2C insert\x2C map_values\x2C new$\x2C size };\n\n/**\n * Determines whether or not the dict is empty.\n *\n * ## Examples\n *\n * ```gleam\n * assert new() |> is_empty\n * ```\n *\n * ```gleam\n * assert !{ new() |> insert("b"\x2C 1) |> is_empty }\n * ```\n */\nexport function is_empty(dict) {\n  return size(dict) === 0;\n}\n\nfunction from_list_loop(loop$transient\x2C loop$list) {\n  while (true) {\n    let transient = loop$transient;\n    let list = loop$list;\n    if (list instanceof $Empty) {\n      return from_transient(transient);\n    } else {\n      let rest = list.tail;\n      let key = list.head[0];\n      let value = list.head[1];\n      loop$transient = transient_insert(key\x2C value\x2C transient);\n      loop$list = rest;\n    }\n  }\n}\n\n/**\n * Converts a list of 2-element tuples `#(key\x2C value)` to a dict.\n *\n * If two tuples have the same key the last one in the list will be the one\n * that is present in the dict.\n */\nexport function from_list(list) {\n  return from_list_loop(to_transient(new$())\x2C list);\n}\n\nfunction do_take_loop(loop$dict\x2C loop$desired_keys\x2C loop$acc) {\n  while (true) {\n    let dict = loop$dict;\n    let desired_keys = loop$desired_keys;\n    let acc = loop$acc;\n    if (desired_keys instanceof $Empty) {\n      return from_transient(acc);\n    } else {\n      let key = desired_keys.head;\n      let rest = desired_keys.tail;\n      let $ = get(dict\x2C key);\n      if ($ instanceof Ok) {\n        let value = $[0];\n        loop$dict = dict;\n        loop$desired_keys = rest;\n        loop$acc = transient_insert(key\x2C value\x2C acc);\n      } else {\n        loop$dict = dict;\n        loop$desired_keys = rest;\n        loop$acc = acc;\n      }\n    }\n  }\n}\n\nfunction do_take(desired_keys\x2C dict) {\n  return do_take_loop(dict\x2C desired_keys\x2C to_transient(new$()));\n}\n\n/**\n * Creates a new dict from a given dict\x2C only including any entries for which the\n * keys are in a given list.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n *   |> take(["b"])\n *   == from_list([#("b"\x2C 1)])\n * ```\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n *   |> take(["a"\x2C "b"\x2C "c"])\n *   == from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n * ```\n */\nexport function take(dict\x2C desired_keys) {\n  return do_take(desired_keys\x2C dict);\n}\n\n/**\n * Creates a new dict from a given dict with all the same entries except for the\n * one with a given key\x2C if it exists.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> delete("a")\n *   == from_list([#("b"\x2C 1)])\n * ```\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> delete("c")\n *   == from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n * ```\n */\nexport function delete$(dict\x2C key) {\n  let _pipe = to_transient(dict);\n  let _pipe$1 = ((_capture) => { return transient_delete(key\x2C _capture); })(\n    _pipe\x2C\n  );\n  return from_transient(_pipe$1);\n}\n\nfunction drop_loop(loop$transient\x2C loop$disallowed_keys) {\n  while (true) {\n    let transient = loop$transient;\n    let disallowed_keys = loop$disallowed_keys;\n    if (disallowed_keys instanceof $Empty) {\n      return from_transient(transient);\n    } else {\n      let key = disallowed_keys.head;\n      let rest = disallowed_keys.tail;\n      loop$transient = transient_delete(key\x2C transient);\n      loop$disallowed_keys = rest;\n    }\n  }\n}\n\nfunction do_drop(disallowed_keys\x2C dict) {\n  return drop_loop(to_transient(dict)\x2C disallowed_keys);\n}\n\n/**\n * Creates a new dict from a given dict with all the same entries except any with\n * keys found in a given list.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> drop(["a"])\n *   == from_list([#("b"\x2C 1)])\n * ```\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> drop(["c"])\n *   == from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n * ```\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> drop(["a"\x2C "b"\x2C "c"])\n *   == from_list([])\n * ```\n */\nexport function drop(dict\x2C disallowed_keys) {\n  return do_drop(disallowed_keys\x2C dict);\n}\n\n/**\n * Creates a new dict with one entry inserted or updated using a given function.\n *\n * If there was not an entry in the dict for the given key then the function\n * gets `None` as its argument\x2C otherwise it gets `Some(value)`.\n *\n * ## Examples\n *\n * ```gleam\n * let dict = from_list([#("a"\x2C 0)])\n * let increment = fn(x) {\n *   case x {\n *     Some(i) -> i + 1\n *     None -> 0\n *   }\n * }\n *\n * assert upsert(dict\x2C "a"\x2C increment) == from_list([#("a"\x2C 1)])\n * ```\n *\n * ```gleam\n * assert upsert(dict\x2C "b"\x2C increment) == from_list([#("a"\x2C 0)\x2C #("b"\x2C 0)])\n * ```\n */\nexport function upsert(dict\x2C key\x2C fun) {\n  let $ = get(dict\x2C key);\n  if ($ instanceof Ok) {\n    let value = $[0];\n    return insert(dict\x2C key\x2C fun(new $option.Some(value)));\n  } else {\n    return insert(dict\x2C key\x2C fun(new $option.None()));\n  }\n}\n\n/**\n * Converts the dict to a list of 2-element tuples `#(key\x2C value)`\x2C one for\n * each key-value pair in the dict.\n *\n * The tuples in the list have no specific order.\n *\n * ## Examples\n *\n * Calling `to_list` on an empty `dict` returns an empty list.\n *\n * ```gleam\n * assert new() |> to_list == []\n * ```\n *\n * The ordering of elements in the resulting list is an implementation detail\n * that should not be relied upon.\n *\n * ```gleam\n * assert new()\n *   |> insert("b"\x2C 1)\n *   |> insert("a"\x2C 0)\n *   |> insert("c"\x2C 2)\n *   |> to_list\n *   == [#("a"\x2C 0)\x2C #("b"\x2C 1)\x2C #("c"\x2C 2)]\n * ```\n */\nexport function to_list(dict) {\n  return fold(\n    dict\x2C\n    toList([])\x2C\n    (acc\x2C key\x2C value) => { return listPrepend([key\x2C value]\x2C acc); }\x2C\n  );\n}\n\n/**\n * Gets a list of all keys in a given dict.\n *\n * Dicts are not ordered so the keys are not returned in any specific order. Do\n * not write code that relies on the order keys are returned by this function\n * as it may change in later versions of Gleam or Erlang.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> keys == ["a"\x2C "b"]\n * ```\n */\nexport function keys(dict) {\n  return fold(\n    dict\x2C\n    toList([])\x2C\n    (acc\x2C key\x2C _) => { return listPrepend(key\x2C acc); }\x2C\n  );\n}\n\n/**\n * Gets a list of all values in a given dict.\n *\n * Dicts are not ordered so the values are not returned in any specific order. Do\n * not write code that relies on the order values are returned by this function\n * as it may change in later versions of Gleam or Erlang.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)]) |> values == [0\x2C 1]\n * ```\n */\nexport function values(dict) {\n  return fold(\n    dict\x2C\n    toList([])\x2C\n    (acc\x2C _\x2C value) => { return listPrepend(value\x2C acc); }\x2C\n  );\n}\n\nfunction do_filter(f\x2C dict) {\n  let _pipe = to_transient(new$());\n  let _pipe$1 = fold(\n    dict\x2C\n    _pipe\x2C\n    (transient\x2C key\x2C value) => {\n      let $ = f(key\x2C value);\n      if ($) {\n        return transient_insert(key\x2C value\x2C transient);\n      } else {\n        return transient;\n      }\n    }\x2C\n  );\n  return from_transient(_pipe$1);\n}\n\n/**\n * Creates a new dict from a given dict\x2C minus any entries that a given function\n * returns `False` for.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n *   |> filter(fn(key\x2C value) { value != 0 })\n *   == from_list([#("b"\x2C 1)])\n * ```\n *\n * ```gleam\n * assert from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n *   |> filter(fn(key\x2C value) { True })\n *   == from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n * ```\n */\nexport function filter(dict\x2C predicate) {\n  return do_filter(predicate\x2C dict);\n}\n\n/**\n * Calls a function for each key and value in a dict\x2C discarding the return\n * value.\n *\n * Useful for producing a side effect for every item of a dict.\n *\n * ```gleam\n * import gleam/io\n *\n * let dict = from_list([#("a"\x2C "apple")\x2C #("b"\x2C "banana")\x2C #("c"\x2C "cherry")])\n *\n * assert\n *   each(dict\x2C fn(k\x2C v) {\n *     io.println(k <> " => " <> v)\n *   })\n *   == Nil\n * // a => apple\n * // b => banana\n * // c => cherry\n * ```\n *\n * The order of elements in the iteration is an implementation detail that\n * should not be relied upon.\n */\nexport function each(dict\x2C fun) {\n  return fold(\n    dict\x2C\n    undefined\x2C\n    (nil\x2C k\x2C v) => {\n      fun(k\x2C v);\n      return nil;\n    }\x2C\n  );\n}\n\nfunction do_combine(combine\x2C left\x2C right) {\n  let _block;\n  let $1 = size(left) >= size(right);\n  if ($1) {\n    _block = [left\x2C right\x2C combine];\n  } else {\n    _block = [right\x2C left\x2C (k\x2C l\x2C r) => { return combine(k\x2C r\x2C l); }];\n  }\n  let $ = _block;\n  let big;\n  let small;\n  let combine$1;\n  big = $[0];\n  small = $[1];\n  combine$1 = $[2];\n  let _pipe = to_transient(big);\n  let _pipe$1 = fold(\n    small\x2C\n    _pipe\x2C\n    (transient\x2C key\x2C value) => {\n      let update = (existing) => { return combine$1(key\x2C existing\x2C value); };\n      return transient_update_with(key\x2C update\x2C value\x2C transient);\n    }\x2C\n  );\n  return from_transient(_pipe$1);\n}\n\n/**\n * Creates a new dict from a pair of given dicts by combining their entries.\n *\n * If there are entries with the same keys in both dicts the given function is\n * used to determine the new value to use in the resulting dict.\n *\n * ## Examples\n *\n * ```gleam\n * let a = from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n * let b = from_list([#("a"\x2C 2)\x2C #("c"\x2C 3)])\n * assert combine(a\x2C b\x2C fn(one\x2C other) { one + other })\n *   == from_list([#("a"\x2C 2)\x2C #("b"\x2C 1)\x2C #("c"\x2C 3)])\n * ```\n */\nexport function combine(dict\x2C other\x2C fun) {\n  return do_combine((_\x2C l\x2C r) => { return fun(l\x2C r); }\x2C dict\x2C other);\n}\n\n/**\n * Creates a new dict from a pair of given dicts by combining their entries.\n *\n * If there are entries with the same keys in both dicts the entry from the\n * second dict takes precedence.\n *\n * ## Examples\n *\n * ```gleam\n * let a = from_list([#("a"\x2C 0)\x2C #("b"\x2C 1)])\n * let b = from_list([#("b"\x2C 2)\x2C #("c"\x2C 3)])\n * assert merge(a\x2C b) == from_list([#("a"\x2C 0)\x2C #("b"\x2C 2)\x2C #("c"\x2C 3)])\n * ```\n */\nexport function merge(dict\x2C new_entries) {\n  return combine(dict\x2C new_entries\x2C (_\x2C new_entry) => { return new_entry; });\n}\n\nfunction group_loop(loop$transient\x2C loop$to_key\x2C loop$list) {\n  while (true) {\n    let transient = loop$transient;\n    let to_key = loop$to_key;\n    let list = loop$list;\n    if (list instanceof $Empty) {\n      return from_transient(transient);\n    } else {\n      let value = list.head;\n      let rest = list.tail;\n      let key = to_key(value);\n      let update = (existing) => { return listPrepend(value\x2C existing); };\n      let _pi