script-source,130,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/option.mjs,import {\n  Ok\x2C\n  Error\x2C\n  toList\x2C\n  Empty as $Empty\x2C\n  prepend as listPrepend\x2C\n  CustomType as $CustomType\x2C\n} from "../gleam.mjs";\n\nexport class Some extends $CustomType {\n  constructor($0) {\n    super();\n    this[0] = $0;\n  }\n}\nexport const Option$Some = ($0) => new Some($0);\nexport const Option$isSome = (value) => value instanceof Some;\nexport const Option$Some$0 = (value) => value[0];\n\nexport class None extends $CustomType {}\nexport const Option$None = () => new None();\nexport const Option$isNone = (value) => value instanceof None;\n\nfunction reverse_and_prepend(loop$prefix\x2C loop$suffix) {\n  while (true) {\n    let prefix = loop$prefix;\n    let suffix = loop$suffix;\n    if (prefix instanceof $Empty) {\n      return suffix;\n    } else {\n      let first = prefix.head;\n      let rest = prefix.tail;\n      loop$prefix = rest;\n      loop$suffix = listPrepend(first\x2C suffix);\n    }\n  }\n}\n\nfunction reverse(list) {\n  return reverse_and_prepend(list\x2C toList([]));\n}\n\nfunction all_loop(loop$list\x2C loop$acc) {\n  while (true) {\n    let list = loop$list;\n    let acc = loop$acc;\n    if (list instanceof $Empty) {\n      return new Some(reverse(acc));\n    } else {\n      let $ = list.head;\n      if ($ instanceof Some) {\n        let rest = list.tail;\n        let first = $[0];\n        loop$list = rest;\n        loop$acc = listPrepend(first\x2C acc);\n      } else {\n        return new None();\n      }\n    }\n  }\n}\n\n/**\n * Combines a list of `Option`s into a single `Option`.\n * If all elements in the list are `Some` then returns a `Some` holding the list of values.\n * If any element is `None` then returns `None`.\n *\n * ## Examples\n *\n * ```gleam\n * assert all([Some(1)\x2C Some(2)]) == Some([1\x2C 2])\n * ```\n *\n * ```gleam\n * assert all([Some(1)\x2C None]) == None\n * ```\n */\nexport function all(list) {\n  return all_loop(list\x2C toList([]));\n}\n\n/**\n * Checks whether the `Option` is a `Some` value.\n *\n * ## Examples\n *\n * ```gleam\n * assert is_some(Some(1))\n * ```\n *\n * ```gleam\n * assert !is_some(None)\n * ```\n */\nexport function is_some(option) {\n  return !(option instanceof None);\n}\n\n/**\n * Checks whether the `Option` is a `None` value.\n *\n * ## Examples\n *\n * ```gleam\n * assert !is_none(Some(1))\n * ```\n *\n * ```gleam\n * assert is_none(None)\n * ```\n */\nexport function is_none(option) {\n  return option instanceof None;\n}\n\n/**\n * Converts an `Option` type to a `Result` type.\n *\n * ## Examples\n *\n * ```gleam\n * assert to_result(Some(1)\x2C "some_error") == Ok(1)\n * ```\n *\n * ```gleam\n * assert to_result(None\x2C "some_error") == Error("some_error")\n * ```\n */\nexport function to_result(option\x2C e) {\n  if (option instanceof Some) {\n    let a = option[0];\n    return new Ok(a);\n  } else {\n    return new Error(e);\n  }\n}\n\n/**\n * Converts a `Result` type to an `Option` type.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_result(Ok(1)) == Some(1)\n * ```\n *\n * ```gleam\n * assert from_result(Error("some_error")) == None\n * ```\n */\nexport function from_result(result) {\n  if (result instanceof Ok) {\n    let a = result[0];\n    return new Some(a);\n  } else {\n    return new None();\n  }\n}\n\n/**\n * Extracts the value from an `Option`\x2C returning a default value if there is none.\n *\n * ## Examples\n *\n * ```gleam\n * assert unwrap(Some(1)\x2C 0) == 1\n * ```\n *\n * ```gleam\n * assert unwrap(None\x2C 0) == 0\n * ```\n */\nexport function unwrap(option\x2C default$) {\n  if (option instanceof Some) {\n    let x = option[0];\n    return x;\n  } else {\n    return default$;\n  }\n}\n\n/**\n * Extracts the value from an `Option`\x2C evaluating the default function if the option is `None`.\n *\n * ## Examples\n *\n * ```gleam\n * assert lazy_unwrap(Some(1)\x2C fn() { 0 }) == 1\n * ```\n *\n * ```gleam\n * assert lazy_unwrap(None\x2C fn() { 0 }) == 0\n * ```\n */\nexport function lazy_unwrap(option\x2C default$) {\n  if (option instanceof Some) {\n    let x = option[0];\n    return x;\n  } else {\n    return default$();\n  }\n}\n\n/**\n * Updates a value held within the `Some` of an `Option` by calling a given function\n * on it.\n *\n * If the `Option` is a `None` rather than `Some`\x2C the function is not called and the\n * `Option` stays the same.\n *\n * ## Examples\n *\n * ```gleam\n * assert map(over: Some(1)\x2C with: fn(x) { x + 1 }) == Some(2)\n * ```\n *\n * ```gleam\n * assert map(over: None\x2C with: fn(x) { x + 1 }) == None\n * ```\n */\nexport function map(option\x2C fun) {\n  if (option instanceof Some) {\n    let x = option[0];\n    return new Some(fun(x));\n  } else {\n    return option;\n  }\n}\n\n/**\n * Merges a nested `Option` into a single layer.\n *\n * ## Examples\n *\n * ```gleam\n * assert flatten(Some(Some(1))) == Some(1)\n * ```\n *\n * ```gleam\n * assert flatten(Some(None)) == None\n * ```\n *\n * ```gleam\n * assert flatten(None) == None\n * ```\n */\nexport function flatten(option) {\n  if (option instanceof Some) {\n    let x = option[0];\n    return x;\n  } else {\n    return option;\n  }\n}\n\n/**\n * Updates a value held within the `Some` of an `Option` by calling a given function\n * on it\x2C where the given function also returns an `Option`. The two options are\n * then merged together into one `Option`.\n *\n * If the `Option` is a `None` rather than `Some` the function is not called and the\n * option stays the same.\n *\n * This function is the equivalent of calling `map` followed by `flatten`\x2C and\n * it is useful for chaining together multiple functions that return `Option`.\n *\n * ## Examples\n *\n * ```gleam\n * assert then(Some(1)\x2C fn(x) { Some(x + 1) }) == Some(2)\n * ```\n *\n * ```gleam\n * assert then(Some(1)\x2C fn(x) { Some(#("a"\x2C x)) }) == Some(#("a"\x2C 1))\n * ```\n *\n * ```gleam\n * assert then(Some(1)\x2C fn(_) { None }) == None\n * ```\n *\n * ```gleam\n * assert then(None\x2C fn(x) { Some(x + 1) }) == None\n * ```\n */\nexport function then$(option\x2C fun) {\n  if (option instanceof Some) {\n    let x = option[0];\n    return fun(x);\n  } else {\n    return option;\n  }\n}\n\n/**\n * Returns the first value if it is `Some`\x2C otherwise returns the second value.\n *\n * ## Examples\n *\n * ```gleam\n * assert or(Some(1)\x2C Some(2)) == Some(1)\n * ```\n *\n * ```gleam\n * assert or(Some(1)\x2C None) == Some(1)\n * ```\n *\n * ```gleam\n * assert or(None\x2C Some(2)) == Some(2)\n * ```\n *\n * ```gleam\n * assert or(None\x2C None) == None\n * ```\n */\nexport function or(first\x2C second) {\n  if (first instanceof Some) {\n    return first;\n  } else {\n    return second;\n  }\n}\n\n/**\n * Returns the first value if it is `Some`\x2C otherwise evaluates the given function for a fallback value.\n *\n * ## Examples\n *\n * ```gleam\n * assert lazy_or(Some(1)\x2C fn() { Some(2) }) == Some(1)\n * ```\n *\n * ```gleam\n * assert lazy_or(Some(1)\x2C fn() { None }) == Some(1)\n * ```\n *\n * ```gleam\n * assert lazy_or(None\x2C fn() { Some(2) }) == Some(2)\n * ```\n *\n * ```gleam\n * assert lazy_or(None\x2C fn() { None }) == None\n * ```\n */\nexport function lazy_or(first\x2C second) {\n  if (first instanceof Some) {\n    return first;\n  } else {\n    return second();\n  }\n}\n\nfunction values_loop(loop$list\x2C loop$acc) {\n  while (true) {\n    let list = loop$list;\n    let acc = loop$acc;\n    if (list instanceof $Empty) {\n      return reverse(acc);\n    } else {\n      let $ = list.head;\n      if ($ instanceof Some) {\n        let rest = list.tail;\n        let first = $[0];\n        loop$list = rest;\n        loop$acc = listPrepend(first\x2C acc);\n      } else {\n        let rest = list.tail;\n        loop$list = rest;\n        loop$acc = acc;\n      }\n    }\n  }\n}\n\n/**\n * Given a list of `Option`s\x2C\n * returns only the values inside `Some`.\n *\n * ## Examples\n *\n * ```gleam\n * assert values([Some(1)\x2C None\x2C Some(3)]) == [1\x2C 3]\n * ```\n */\nexport function values(options) {\n  return values_loop(options\x2C toList([]));\n}\n
