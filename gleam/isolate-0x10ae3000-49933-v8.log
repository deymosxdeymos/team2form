script-source,147,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/team2form_gleam/team2form_gleam/codec.mjs,import * as $json from "../../gleam_json/gleam/json.mjs";\nimport * as $dict from "../../gleam_stdlib/gleam/dict.mjs";\nimport * as $decode from "../../gleam_stdlib/gleam/dynamic/decode.mjs";\nimport * as $int from "../../gleam_stdlib/gleam/int.mjs";\nimport * as $list from "../../gleam_stdlib/gleam/list.mjs";\nimport * as $option from "../../gleam_stdlib/gleam/option.mjs";\nimport { None\x2C Some } from "../../gleam_stdlib/gleam/option.mjs";\nimport * as $result from "../../gleam_stdlib/gleam/result.mjs";\nimport * as $string from "../../gleam_stdlib/gleam/string.mjs";\nimport { Ok\x2C Error\x2C toList\x2C Empty as $Empty } from "../gleam.mjs";\nimport * as $formation_decode_fast from "../team2form_gleam/formation_decode_fast.mjs";\nimport * as $models from "../team2form_gleam/models.mjs";\nimport * as $quality_decode_fast from "../team2form_gleam/quality_decode_fast.mjs";\n\nfunction number_decoder() {\n  return $decode.one_of(\n    $decode.float\x2C\n    toList([$decode.map($decode.int\x2C $int.to_float)])\x2C\n  );\n}\n\nfunction bounded_float_decoder(minimum\x2C maximum\x2C expected) {\n  return $decode.then$(\n    number_decoder()\x2C\n    (value) => {\n      let $ = (value >= minimum) && (value <= maximum);\n      if ($) {\n        return $decode.success(value);\n      } else {\n        return $decode.failure(0.0\x2C expected);\n      }\n    }\x2C\n  );\n}\n\nfunction at_least_float_decoder(minimum\x2C expected) {\n  return $decode.then$(\n    number_decoder()\x2C\n    (value) => {\n      let $ = value >= minimum;\n      if ($) {\n        return $decode.success(value);\n      } else {\n        return $decode.failure(0.0\x2C expected);\n      }\n    }\x2C\n  );\n}\n\nfunction non_empty_string_decoder(expected) {\n  return $decode.then$(\n    $decode.string\x2C\n    (value) => {\n      if (value === "") {\n        return $decode.failure(""\x2C expected);\n      } else {\n        return $decode.success(value);\n      }\n    }\x2C\n  );\n}\n\nfunction list_has_min_length(loop$values\x2C loop$min_length) {\n  while (true) {\n    let values = loop$values;\n    let min_length = loop$min_length;\n    let $ = min_length <= 0;\n    if ($) {\n      return $;\n    } else {\n      if (values instanceof $Empty) {\n        return false;\n      } else {\n        let rest = values.tail;\n        loop$values = rest;\n        loop$min_length = min_length - 1;\n      }\n    }\n  }\n}\n\nfunction list_min_length_decoder(inner\x2C min_length\x2C expected) {\n  return $decode.then$(\n    $decode.list(inner)\x2C\n    (values) => {\n      let $ = list_has_min_length(values\x2C min_length);\n      if ($) {\n        return $decode.success(values);\n      } else {\n        return $decode.failure(toList([])\x2C expected);\n      }\n    }\x2C\n  );\n}\n\nfunction positive_int_decoder(minimum\x2C expected) {\n  return $decode.then$(\n    $decode.int\x2C\n    (value) => {\n      let $ = value >= minimum;\n      if ($) {\n        return $decode.success(value);\n      } else {\n        return $decode.failure(0\x2C expected);\n      }\n    }\x2C\n  );\n}\n\nfunction gender_decoder() {\n  return $decode.then$(\n    $decode.string\x2C\n    (value) => {\n      let $ = $models.gender_from_string(value);\n      if ($ instanceof Ok) {\n        let gender = $[0];\n        return $decode.success(gender);\n      } else {\n        let message = $[0];\n        return $decode.failure(new $models.Female()\x2C message);\n      }\n    }\x2C\n  );\n}\n\nfunction personality_decoder() {\n  return $decode.field(\n    "ei"\x2C\n    bounded_float_decoder(-1.0\x2C 1.0\x2C "Personality.ei")\x2C\n    (ei) => {\n      return $decode.field(\n        "sn"\x2C\n        bounded_float_decoder(-1.0\x2C 1.0\x2C "Personality.sn")\x2C\n        (sn) => {\n          return $decode.field(\n            "tf"\x2C\n            bounded_float_decoder(-1.0\x2C 1.0\x2C "Personality.tf")\x2C\n            (tf) => {\n              return $decode.field(\n                "pj"\x2C\n                bounded_float_decoder(-1.0\x2C 1.0\x2C "Personality.pj")\x2C\n                (pj) => {\n                  return $decode.success(\n                    new $models.Personality(ei\x2C sn\x2C tf\x2C pj)\x2C\n                  );\n                }\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction person_skill_decoder() {\n  return $decode.field(\n    "id"\x2C\n    non_empty_string_decoder("PersonSkill.id")\x2C\n    (id) => {\n      return $decode.field(\n        "level"\x2C\n        bounded_float_decoder(0.0\x2C 1.0\x2C "PersonSkill.level")\x2C\n        (level) => {\n          return $decode.success(new $models.PersonSkill(id\x2C level));\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction person_preference_decoder() {\n  return $decode.field(\n    "personId"\x2C\n    non_empty_string_decoder("PersonPreference.personId")\x2C\n    (person_id) => {\n      return $decode.field(\n        "preference"\x2C\n        bounded_float_decoder(0.0\x2C 1.0\x2C "PersonPreference.preference")\x2C\n        (preference) => {\n          return $decode.success(\n            new $models.PersonPreference(person_id\x2C preference)\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction person_decoder() {\n  return $decode.field(\n    "id"\x2C\n    non_empty_string_decoder("Person.id")\x2C\n    (id) => {\n      return $decode.optional_field(\n        "gender"\x2C\n        new None()\x2C\n        $decode.optional(gender_decoder())\x2C\n        (gender) => {\n          return $decode.field(\n            "personality"\x2C\n            personality_decoder()\x2C\n            (personality) => {\n              return $decode.optional_field(\n                "skills"\x2C\n                toList([])\x2C\n                $decode.list(person_skill_decoder())\x2C\n                (skills) => {\n                  return $decode.optional_field(\n                    "preferences"\x2C\n                    new None()\x2C\n                    $decode.optional($decode.list(person_preference_decoder()))\x2C\n                    (preferences) => {\n                      return $decode.success(\n                        new $models.Person(\n                          id\x2C\n                          gender\x2C\n                          personality\x2C\n                          skills\x2C\n                          preferences\x2C\n                        )\x2C\n                      );\n                    }\x2C\n                  );\n                }\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction task_skill_decoder() {\n  return $decode.field(\n    "id"\x2C\n    non_empty_string_decoder("TaskSkill.id")\x2C\n    (id) => {\n      return $decode.field(\n        "level"\x2C\n        bounded_float_decoder(0.0\x2C 1.0\x2C "TaskSkill.level")\x2C\n        (level) => {\n          return $decode.field(\n            "importance"\x2C\n            at_least_float_decoder(1.0\x2C "TaskSkill.importance")\x2C\n            (importance) => {\n              return $decode.success(\n                new $models.TaskSkill(id\x2C level\x2C importance)\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction task_preference_decoder() {\n  return $decode.field(\n    "personId"\x2C\n    non_empty_string_decoder("TaskPreference.personId")\x2C\n    (person_id) => {\n      return $decode.field(\n        "preference"\x2C\n        bounded_float_decoder(0.0\x2C 1.0\x2C "TaskPreference.preference")\x2C\n        (preference) => {\n          return $decode.success(\n            new $models.TaskPreference(person_id\x2C preference)\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction task_decoder() {\n  return $decode.field(\n    "id"\x2C\n    non_empty_string_decoder("Task.id")\x2C\n    (id) => {\n      return $decode.field(\n        "teamSize"\x2C\n        positive_int_decoder(2\x2C "Task.teamSize")\x2C\n        (team_size) => {\n          return $decode.field(\n            "skills"\x2C\n            list_min_length_decoder(task_skill_decoder()\x2C 1\x2C "Task.skills")\x2C\n            (skills) => {\n              return $decode.optional_field(\n                "preferences"\x2C\n                new None()\x2C\n                $decode.optional($decode.list(task_preference_decoder()))\x2C\n                (preferences) => {\n                  return $decode.success(\n                    new $models.Task(id\x2C team_size\x2C skills\x2C preferences)\x2C\n                  );\n                }\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction similarity_decoder() {\n  return $decode.field(\n    "sourceId"\x2C\n    non_empty_string_decoder("Similarity.sourceId")\x2C\n    (source_id) => {\n      return $decode.field(\n        "targetId"\x2C\n        non_empty_string_decoder("Similarity.targetId")\x2C\n        (target_id) => {\n          return $decode.field(\n            "similarity"\x2C\n            bounded_float_decoder(0.0\x2C 1.0\x2C "Similarity.similarity")\x2C\n            (similarity) => {\n              return $decode.success(\n                new $models.Similarity(source_id\x2C target_id\x2C similarity)\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction team_member_decoder() {\n  return $decode.field(\n    "id"\x2C\n    non_empty_string_decoder("TeamMember.id")\x2C\n    (id) => {\n      return $decode.optional_field(\n        "gender"\x2C\n        new None()\x2C\n        $decode.optional(gender_decoder())\x2C\n        (gender) => {\n          return $decode.field(\n            "personality"\x2C\n            personality_decoder()\x2C\n            (personality) => {\n              return $decode.optional_field(\n                "skills"\x2C\n                toList([])\x2C\n                $decode.list(person_skill_decoder())\x2C\n                (skills) => {\n                  return $decode.optional_field(\n                    "preferences"\x2C\n                    new None()\x2C\n                    $decode.optional($decode.list(person_preference_decoder()))\x2C\n                    (preferences) => {\n                      return $decode.optional_field(\n                        "taskPreference"\x2C\n                        new None()\x2C\n                        $decode.optional(\n                          bounded_float_decoder(\n                            0.0\x2C\n                            1.0\x2C\n                            "TeamMember.taskPreference"\x2C\n                          )\x2C\n                        )\x2C\n                        (task_preference) => {\n                          return $decode.success(\n                            new $models.TeamMember(\n                              id\x2C\n                              gender\x2C\n                              personality\x2C\n                              skills\x2C\n                              preferences\x2C\n                              task_preference\x2C\n                            )\x2C\n                          );\n                        }\x2C\n                      );\n                    }\x2C\n                  );\n                }\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction formation_request_decoder() {\n  return $decode.field(\n    "people"\x2C\n    list_min_length_decoder(person_decoder()\x2C 2\x2C "FormationRequest.people")\x2C\n    (people) => {\n      return $decode.field(\n        "tasks"\x2C\n        list_min_length_decoder(task_decoder()\x2C 1\x2C "FormationRequest.tasks")\x2C\n        (tasks) => {\n          return $decode.optional_field(\n            "initRandom"\x2C\n            false\x2C\n            $decode.bool\x2C\n            (init_random) => {\n              return $decode.optional_field(\n                "alpha"\x2C\n                new None()\x2C\n                $decode.optional(\n                  bounded_float_decoder(0.0\x2C 1.0\x2C "FormationRequest.alpha")\x2C\n                )\x2C\n                (alpha) => {\n                  return $decode.optional_field(\n                    "beta"\x2C\n                    new None()\x2C\n                    $decode.optional(\n                      bounded_float_decoder(0.0\x2C 1.0\x2C "FormationRequest.beta")\x2C\n                    )\x2C\n                    (beta) => {\n                      return $decode.optional_field(\n                        "gamma"\x2C\n                        new None()\x2C\n                        $decode.optional(\n                          bounded_float_decoder(\n                            0.0\x2C\n                            1.0\x2C\n                            "FormationRequest.gamma"\x2C\n                          )\x2C\n                        )\x2C\n                        (gamma) => {\n                          return $decode.optional_field(\n                            "delta"\x2C\n                            new None()\x2C\n                            $decode.optional(\n                              bounded_float_decoder(\n                                0.0\x2C\n                                1.0\x2C\n                                "FormationRequest.delta"\x2C\n                              )\x2C\n                            )\x2C\n                            (delta) => {\n                              return $decode.optional_field(\n                                "similarities"\x2C\n                                new None()\x2C\n                                $decode.optional(\n                                  $decode.list(similarity_decoder())\x2C\n                                )\x2C\n                                (similarities) => {\n                                  return $decode.success(\n                                    new $models.FormationRequest(\n                                      people\x2C\n                                      tasks\x2C\n                                      init_random\x2C\n                                      alpha\x2C\n                                      beta\x2C\n                                      gamma\x2C\n                                      delta\x2C\n                                      similarities\x2C\n                                    )\x2C\n                                  );\n                                }\x2C\n                              );\n                            }\x2C\n                          );\n                        }\x2C\n                      );\n                    }\x2C\n                  );\n                }\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction team_quality_request_decoder() {\n  return $decode.field(\n    "taskSkills"\x2C\n    list_min_length_decoder(\n      task_skill_decoder()\x2C\n      1\x2C\n      "TeamQualityRequest.taskSkills"\x2C\n    )\x2C\n    (task_skills) => {\n      return $decode.field(\n        "team"\x2C\n        list_min_length_decoder(\n          team_member_decoder()\x2C\n          2\x2C\n          "TeamQualityRequest.team"\x2C\n        )\x2C\n        (team) => {\n          return $decode.optional_field(\n            "alpha"\x2C\n            new None()\x2C\n            $decode.optional(\n              bounded_float_decoder(0.0\x2C 1.0\x2C "TeamQualityRequest.alpha")\x2C\n            )\x2C\n            (alpha) => {\n              return $decode.optional_field(\n                "beta"\x2C\n                new None()\x2C\n                $decode.optional(\n                  bounded_float_decoder(0.0\x2C 1.0\x2C "TeamQualityRequest.beta")\x2C\n                )\x2C\n                (beta) => {\n                  return $decode.optional_field(\n                    "gamma"\x2C\n                    new None()\x2C\n                    $decode.optional(\n                      bounded_float_decoder(\n                        0.0\x2C\n                        1.0\x2C\n                        "TeamQualityRequest.gamma"\x2C\n                      )\x2C\n                    )\x2C\n                    (gamma) => {\n                      return $decode.optional_field(\n                        "delta"\x2C\n                        new None()\x2C\n                        $decode.optional(\n                          bounded_float_decoder(\n                            0.0\x2C\n                            1.0\x2C\n                            "TeamQualityRequest.delta"\x2C\n                          )\x2C\n                        )\x2C\n                        (delta) => {\n                          return $decode.optional_field(\n                            "similarities"\x2C\n                            new None()\x2C\n                            $decode.optional($decode.list(similarity_decoder()))\x2C\n                            (similarities) => {\n                              return $decode.success(\n                                new $models.TeamQualityRequest(\n                                  task_skills\x2C\n                                  team\x2C\n                                  alpha\x2C\n                                  beta\x2C\n                                  gamma\x2C\n                                  delta\x2C\n                                  similarities\x2C\n                                )\x2C\n                              );\n                            }\x2C\n                          );\n                        }\x2C\n                      );\n                    }\x2C\n                  );\n                }\x2C\n              );\n            }\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction parse_json(source\x2C decoder) {\n  let $ = $json.parse(so