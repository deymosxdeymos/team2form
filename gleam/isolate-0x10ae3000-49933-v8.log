script-source,141,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/dynamic/decode.mjs,import {\n  Ok\x2C\n  Error\x2C\n  toList\x2C\n  Empty as $Empty\x2C\n  prepend as listPrepend\x2C\n  CustomType as $CustomType\x2C\n  isEqual\x2C\n} from "../../gleam.mjs";\nimport * as $bit_array from "../../gleam/bit_array.mjs";\nimport * as $dict from "../../gleam/dict.mjs";\nimport * as $dynamic from "../../gleam/dynamic.mjs";\nimport * as $float from "../../gleam/float.mjs";\nimport * as $int from "../../gleam/int.mjs";\nimport * as $list from "../../gleam/list.mjs";\nimport * as $option from "../../gleam/option.mjs";\nimport { None\x2C Some } from "../../gleam/option.mjs";\nimport {\n  index as bare_index\x2C\n  int as dynamic_int\x2C\n  float as dynamic_float\x2C\n  bit_array as dynamic_bit_array\x2C\n  list as decode_list\x2C\n  dict as decode_dict\x2C\n  identity as cast\x2C\n  is_null\x2C\n  string as dynamic_string\x2C\n} from "../../gleam_stdlib.mjs";\n\nexport class DecodeError extends $CustomType {\n  constructor(expected\x2C found\x2C path) {\n    super();\n    this.expected = expected;\n    this.found = found;\n    this.path = path;\n  }\n}\nexport const DecodeError$DecodeError = (expected\x2C found\x2C path) =>\n  new DecodeError(expected\x2C found\x2C path);\nexport const DecodeError$isDecodeError = (value) =>\n  value instanceof DecodeError;\nexport const DecodeError$DecodeError$expected = (value) => value.expected;\nexport const DecodeError$DecodeError$0 = (value) => value.expected;\nexport const DecodeError$DecodeError$found = (value) => value.found;\nexport const DecodeError$DecodeError$1 = (value) => value.found;\nexport const DecodeError$DecodeError$path = (value) => value.path;\nexport const DecodeError$DecodeError$2 = (value) => value.path;\n\nclass Decoder extends $CustomType {\n  constructor(function$) {\n    super();\n    this.function = function$;\n  }\n}\n\n/**\n * A decoder that decodes `Dynamic` values. This decoder never returns an error.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.float(3.14)\x2C decode.dynamic)\n * assert result == Ok(dynamic.float(3.14))\n * ```\n */\nexport const dynamic = /* @__PURE__ */ new Decoder(decode_dynamic);\n\n/**\n * A decoder that decodes `Bool` values.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.bool(True)\x2C decode.bool)\n * assert result == Ok(True)\n * ```\n */\nexport const bool = /* @__PURE__ */ new Decoder(decode_bool);\n\n/**\n * A decoder that decodes `Int` values.\n *\n * This will not coerse float values into int values\x2C so on platforms with\n * distinct runtime int and float types (Erlang\x2C not JavaScript) it will fail\x2C\n * even if the float is a whole number (e.g. 1.0).\n *\n * If you want to decode both ints and floats you may want to use the `one_of`\n * function.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.int(147)\x2C decode.int)\n * assert result == Ok(147)\n * ```\n */\nexport const int = /* @__PURE__ */ new Decoder(decode_int);\n\n/**\n * A decoder that decodes `Float` values.\n *\n * This will not coerse int values into float values\x2C so on platforms with\n * distinct runtime int and float types (Erlang\x2C not JavaScript) it will fail\n * for ints. One time this may happen is when decoding JSON data.\n *\n * If you want to decode both ints and floats you may want to use the `one_of`\n * function.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.float(3.14)\x2C decode.float)\n * assert result == Ok(3.14)\n * ```\n */\nexport const float = /* @__PURE__ */ new Decoder(decode_float);\n\n/**\n * A decoder that decodes `BitArray` values. This decoder never returns an error.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.bit_array(<<5\x2C 7>>)\x2C decode.bit_array)\n * assert result == Ok(<<5\x2C 7>>)\n * ```\n */\nexport const bit_array = /* @__PURE__ */ new Decoder(decode_bit_array);\n\n/**\n * A decoder that decodes `String` values.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.string("Hello!")\x2C decode.string)\n * assert result == Ok("Hello!")\n * ```\n */\nexport const string = /* @__PURE__ */ new Decoder(decode_string);\n\n/**\n * Run a decoder on a `Dynamic` value\x2C decoding the value if it is of the\n * desired type\x2C or returning errors.\n *\n * ## Examples\n *\n * ```gleam\n * let decoder = {\n *   use name <- decode.field("name"\x2C decode.string)\n *   use email <- decode.field("email"\x2C decode.string)\n *   decode.success(SignUp(name: name\x2C email: email))\n * }\n *\n * decode.run(data\x2C decoder)\n * ```\n */\nexport function run(data\x2C decoder) {\n  let $ = decoder.function(data);\n  let maybe_invalid_data;\n  let errors;\n  maybe_invalid_data = $[0];\n  errors = $[1];\n  if (errors instanceof $Empty) {\n    return new Ok(maybe_invalid_data);\n  } else {\n    return new Error(errors);\n  }\n}\n\n/**\n * Finalise a decoder having successfully extracted a value.\n *\n * ## Examples\n *\n * ```gleam\n * let data = dynamic.properties([\n *   #(dynamic.string("email")\x2C dynamic.string("lucy@example.com"))\x2C\n *   #(dynamic.string("name")\x2C dynamic.string("Lucy"))\x2C\n * ])\n *\n * let decoder = {\n *   use name <- decode.field("name"\x2C string)\n *   use email <- decode.field("email"\x2C string)\n *   decode.success(SignUp(name: name\x2C email: email))\n * }\n *\n * let result = decode.run(data\x2C decoder)\n * assert result == Ok(SignUp(name: "Lucy"\x2C email: "lucy@example.com"))\n * ```\n */\nexport function success(data) {\n  return new Decoder((_) => { return [data\x2C toList([])]; });\n}\n\nfunction decode_dynamic(data) {\n  return [data\x2C toList([])];\n}\n\n/**\n * Apply a transformation function to any value decoded by the decoder.\n *\n * ## Examples\n *\n * ```gleam\n * let decoder = decode.int |> decode.map(int.to_string)\n * let result = decode.run(dynamic.int(1000)\x2C decoder)\n * assert result == Ok("1000")\n * ```\n */\nexport function map(decoder\x2C transformer) {\n  return new Decoder(\n    (d) => {\n      let $ = decoder.function(d);\n      let data;\n      let errors;\n      data = $[0];\n      errors = $[1];\n      return [transformer(data)\x2C errors];\n    }\x2C\n  );\n}\n\n/**\n * Apply a transformation function to any errors returned by the decoder.\n */\nexport function map_errors(decoder\x2C transformer) {\n  return new Decoder(\n    (d) => {\n      let $ = decoder.function(d);\n      let data;\n      let errors;\n      data = $[0];\n      errors = $[1];\n      return [data\x2C transformer(errors)];\n    }\x2C\n  );\n}\n\n/**\n * Create a new decoder based upon the value of a previous decoder.\n *\n * This may be useful to run one previous decoder to use in further decoding.\n */\nexport function then$(decoder\x2C next) {\n  return new Decoder(\n    (dynamic_data) => {\n      let $ = decoder.function(dynamic_data);\n      let data;\n      let errors;\n      data = $[0];\n      errors = $[1];\n      let decoder$1 = next(data);\n      let $1 = decoder$1.function(dynamic_data);\n      let layer;\n      let data$1;\n      layer = $1;\n      data$1 = $1[0];\n      if (errors instanceof $Empty) {\n        return layer;\n      } else {\n        return [data$1\x2C errors];\n      }\n    }\x2C\n  );\n}\n\nfunction run_decoders(loop$data\x2C loop$failure\x2C loop$decoders) {\n  while (true) {\n    let data = loop$data;\n    let failure = loop$failure;\n    let decoders = loop$decoders;\n    if (decoders instanceof $Empty) {\n      return failure;\n    } else {\n      let decoder = decoders.head;\n      let decoders$1 = decoders.tail;\n      let $ = decoder.function(data);\n      let layer;\n      let errors;\n      layer = $;\n      errors = $[1];\n      if (errors instanceof $Empty) {\n        return layer;\n      } else {\n        loop$data = data;\n        loop$failure = failure;\n        loop$decoders = decoders$1;\n      }\n    }\n  }\n}\n\n/**\n * Create a new decoder from several other decoders. Each of the inner\n * decoders is run in turn\x2C and the value from the first to succeed is used.\n *\n * If no decoder succeeds then the errors from the first decoder are used.\n * If you wish for different errors then you may wish to use the\n * `collapse_errors` or `map_errors` functions.\n *\n * ## Examples\n *\n * ```gleam\n * let decoder = decode.one_of(decode.string\x2C or: [\n *   decode.int |> decode.map(int.to_string)\x2C\n *   decode.float |> decode.map(float.to_string)\x2C\n * ])\n * assert decode.run(dynamic.int(1000)\x2C decoder) == Ok("1000")\n * ```\n */\nexport function one_of(first\x2C alternatives) {\n  return new Decoder(\n    (dynamic_data) => {\n      let $ = first.function(dynamic_data);\n      let layer;\n      let errors;\n      layer = $;\n      errors = $[1];\n      if (errors instanceof $Empty) {\n        return layer;\n      } else {\n        return run_decoders(dynamic_data\x2C layer\x2C alternatives);\n      }\n    }\x2C\n  );\n}\n\n/**\n * Create a decoder that can refer to itself\x2C useful for decoding deeply\n * nested data.\n *\n * Attempting to create a recursive decoder without this function could result\n * in an infinite loop. If you are using `field` or other `use`able functions\n * then you may not need to use this function.\n *\n * ## Examples\n *\n * ```gleam\n * type Nested {\n *   Nested(List(Nested))\n *   Value(String)\n * }\n *\n * fn nested_decoder() -> decode.Decoder(Nested) {\n *   use <- decode.recursive\n *   decode.one_of(decode.string |> decode.map(Value)\x2C [\n *     decode.list(nested_decoder()) |> decode.map(Nested)\x2C\n *   ])\n * }\n * ```\n */\nexport function recursive(inner) {\n  return new Decoder(\n    (data) => {\n      let decoder = inner();\n      return decoder.function(data);\n    }\x2C\n  );\n}\n\n/**\n * A decoder that decodes nullable values of a type decoded by with a given\n * decoder.\n *\n * This function can handle common representations of null on all runtimes\x2C such as\n * `nil`\x2C `null`\x2C and `undefined` on Erlang\x2C and `undefined` and `null` on\n * JavaScript.\n *\n * ## Examples\n *\n * ```gleam\n * let result = decode.run(dynamic.int(100)\x2C decode.optional(decode.int))\n * assert result == Ok(option.Some(100))\n * ```\n *\n * ```gleam\n * let result = decode.run(dynamic.nil()\x2C decode.optional(decode.int))\n * assert result == Ok(option.None)\n * ```\n */\nexport function optional(inner) {\n  return new Decoder(\n    (data) => {\n      let $ = is_null(data);\n      if ($) {\n        return [new $option.None()\x2C toList([])];\n      } else {\n        let $1 = inner.function(data);\n        let data$1;\n        let errors;\n        data$1 = $1[0];\n        errors = $1[1];\n        return [new $option.Some(data$1)\x2C errors];\n      }\n    }\x2C\n  );\n}\n\n/**\n * Construct a decode error for some unexpected dynamic data.\n */\nexport function decode_error(expected\x2C found) {\n  return toList([\n    new DecodeError(expected\x2C $dynamic.classify(found)\x2C toList([]))\x2C\n  ]);\n}\n\nfunction run_dynamic_function(data\x2C name\x2C f) {\n  let $ = f(data);\n  if ($ instanceof Ok) {\n    let data$1 = $[0];\n    return [data$1\x2C toList([])];\n  } else {\n    let placeholder = $[0];\n    return [\n      placeholder\x2C\n      toList([new DecodeError(name\x2C $dynamic.classify(data)\x2C toList([]))])\x2C\n    ];\n  }\n}\n\nfunction decode_bool(data) {\n  let $ = isEqual(cast(true)\x2C data);\n  if ($) {\n    return [true\x2C toList([])];\n  } else {\n    let $1 = isEqual(cast(false)\x2C data);\n    if ($1) {\n      return [false\x2C toList([])];\n    } else {\n      return [false\x2C decode_error("Bool"\x2C data)];\n    }\n  }\n}\n\nfunction decode_int(data) {\n  return run_dynamic_function(data\x2C "Int"\x2C dynamic_int);\n}\n\nfunction decode_float(data) {\n  return run_dynamic_function(data\x2C "Float"\x2C dynamic_float);\n}\n\nfunction decode_bit_array(data) {\n  return run_dynamic_function(data\x2C "BitArray"\x2C dynamic_bit_array);\n}\n\n/**\n * Replace all errors produced by a decoder with one single error for a named\n * expected type.\n *\n * This function may be useful if you wish to simplify errors before\n * presenting them to a user\x2C particularly when using the `one_of` function.\n *\n * ## Examples\n *\n * ```gleam\n * let decoder = decode.string |> decode.collapse_errors("MyThing")\n * let result = decode.run(dynamic.int(1000)\x2C decoder)\n * assert result == Error([DecodeError("MyThing"\x2C "Int"\x2C [])])\n * ```\n */\nexport function collapse_errors(decoder\x2C name) {\n  return new Decoder(\n    (dynamic_data) => {\n      let $ = decoder.function(dynamic_data);\n      let layer;\n      let data;\n      let errors;\n      layer = $;\n      data = $[0];\n      errors = $[1];\n      if (errors instanceof $Empty) {\n        return layer;\n      } else {\n        return [data\x2C decode_error(name\x2C dynamic_data)];\n      }\n    }\x2C\n  );\n}\n\n/**\n * Define a decoder that always fails.\n *\n * The first parameter is a "placeholder" value\x2C which is some default value that the\n * decoder uses internally in place of the value that would have been produced\n * if the decoder was successful. It doesn't matter what this value is\x2C it is\n * never returned by the decoder or shown to the user\x2C so pick some arbitrary\n * value. If it is an int you might pick `0`\x2C if it is a list you might pick\n * `[]`.\n *\n * The second parameter is the name of the type that has failed to decode.\n *\n * ```gleam\n * decode.failure(User(name: ""\x2C score: 0\x2C tags: [])\x2C expected: "User")\n * ```\n */\nexport function failure(placeholder\x2C name) {\n  return new Decoder((d) => { return [placeholder\x2C decode_error(name\x2C d)]; });\n}\n\n/**\n * Create a decoder for a new data type from a decoding function.\n *\n * This function is used for new primitive types. For example\x2C you might\n * define a decoder for Erlang's pid type.\n *\n * A default "placeholder" value is also required to make a decoder. When this\n * decoder is used as part of a larger decoder this placeholder value is used\n * so that the rest of the decoder can continue to run and\n * collect all decoding errors. It doesn't matter what this value is\x2C it is\n * never returned by the decoder or shown to the user\x2C so pick some arbitrary\n * value. If it is an int you might pick `0`\x2C if it is a list you might pick\n * `[]`.\n *\n * If you were to make a decoder for the `Int` type (rather than using the\n * build-in `Int` decoder) you would define it like so:\n *\n * ```gleam\n * pub fn int_decoder() -> decode.Decoder(Int) {\n *   let default = ""\n *   decode.new_primitive_decoder("Int"\x2C int_from_dynamic)\n * }\n *\n * @external(erlang\x2C "my_module"\x2C "int_from_dynamic")\n * fn int_from_dynamic(data: Int) -> Result(Int\x2C Int)\n * ```\n *\n * ```erlang\n * -module(my_module).\n * -export([int_from_dynamic/1]).\n *\n * int_from_dynamic(Data) ->\n *     case is_integer(Data) of\n *         true -> {ok\x2C Data};\n *         false -> {error\x2C 0}\n *     end.\n * ```\n */\nexport function new_primitive_decoder(name\x2C decoding_function) {\n  return new Decoder(\n    (d) => {\n      let $ = decoding_function(d);\n      if ($ instanceof Ok) {\n        let t = $[0];\n        return [t\x2C toList([])];\n      } else {\n        let placeholder = $[0];\n        return [\n          placeholder\x2C\n          toList([new DecodeError(name\x2C $dynamic.classify(d)\x2C toList([]))])\x2C\n        ];\n      }\n    }\x2C\n  );\n}\n\nfunction decode_string(data) {\n  return run_dynamic_function(data\x2C "String"\x2C dynamic_string);\n}\n\nfunction path_segment_to_string(key) {\n  let decoder = one_of(\n    string\x2C\n    toList([\n      (() => {\n        let _pipe = int;\n        return map(_pipe\x2C $int.to_string);\n      })()\x2C\n      (() => {\n        let _pipe = float;\n        re