script-source,133,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/result.mjs,import { Ok\x2C Error\x2C toList\x2C Empty as $Empty\x2C prepend as listPrepend } from "../gleam.mjs";\nimport * as $list from "../gleam/list.mjs";\n\n/**\n * Checks whether the result is an `Ok` value.\n *\n * ## Examples\n *\n * ```gleam\n * assert is_ok(Ok(1))\n * ```\n *\n * ```gleam\n * assert !is_ok(Error(Nil))\n * ```\n */\nexport function is_ok(result) {\n  if (result instanceof Ok) {\n    return true;\n  } else {\n    return false;\n  }\n}\n\n/**\n * Checks whether the result is an `Error` value.\n *\n * ## Examples\n *\n * ```gleam\n * assert !is_error(Ok(1))\n * ```\n *\n * ```gleam\n * assert is_error(Error(Nil))\n * ```\n */\nexport function is_error(result) {\n  if (result instanceof Ok) {\n    return false;\n  } else {\n    return true;\n  }\n}\n\n/**\n * Updates a value held within the `Ok` of a result by calling a given function\n * on it.\n *\n * If the result is an `Error` rather than `Ok` the function is not called and the\n * result stays the same.\n *\n * ## Examples\n *\n * ```gleam\n * assert map(over: Ok(1)\x2C with: fn(x) { x + 1 }) == Ok(2)\n * ```\n *\n * ```gleam\n * assert map(over: Error(1)\x2C with: fn(x) { x + 1 }) == Error(1)\n * ```\n */\nexport function map(result\x2C fun) {\n  if (result instanceof Ok) {\n    let x = result[0];\n    return new Ok(fun(x));\n  } else {\n    return result;\n  }\n}\n\n/**\n * Updates a value held within the `Error` of a result by calling a given function\n * on it.\n *\n * If the result is `Ok` rather than `Error` the function is not called and the\n * result stays the same.\n *\n * ## Examples\n *\n * ```gleam\n * assert map_error(over: Error(1)\x2C with: fn(x) { x + 1 }) == Error(2)\n * ```\n *\n * ```gleam\n * assert map_error(over: Ok(1)\x2C with: fn(x) { x + 1 }) == Ok(1)\n * ```\n */\nexport function map_error(result\x2C fun) {\n  if (result instanceof Ok) {\n    return result;\n  } else {\n    let error = result[0];\n    return new Error(fun(error));\n  }\n}\n\n/**\n * Merges a nested `Result` into a single layer.\n *\n * ## Examples\n *\n * ```gleam\n * assert flatten(Ok(Ok(1))) == Ok(1)\n * ```\n *\n * ```gleam\n * assert flatten(Ok(Error(""))) == Error("")\n * ```\n *\n * ```gleam\n * assert flatten(Error(Nil)) == Error(Nil)\n * ```\n */\nexport function flatten(result) {\n  if (result instanceof Ok) {\n    let x = result[0];\n    return x;\n  } else {\n    return result;\n  }\n}\n\n/**\n * "Updates" an `Ok` result by passing its value to a function that yields a result\x2C\n * and returning the yielded result. (This may "replace" the `Ok` with an `Error`.)\n *\n * If the input is an `Error` rather than an `Ok`\x2C the function is not called and\n * the original `Error` is returned.\n *\n * This function is the equivalent of calling `map` followed by `flatten`\x2C and\n * it is useful for chaining together multiple functions that may fail.\n *\n * ## Examples\n *\n * ```gleam\n * assert try(Ok(1)\x2C fn(x) { Ok(x + 1) }) == Ok(2)\n * ```\n *\n * ```gleam\n * assert try(Ok(1)\x2C fn(x) { Ok(#("a"\x2C x)) }) == Ok(#("a"\x2C 1))\n * ```\n *\n * ```gleam\n * assert try(Ok(1)\x2C fn(_) { Error("Oh no") }) == Error("Oh no")\n * ```\n *\n * ```gleam\n * assert try(Error(Nil)\x2C fn(x) { Ok(x + 1) }) == Error(Nil)\n * ```\n */\nexport function try$(result\x2C fun) {\n  if (result instanceof Ok) {\n    let x = result[0];\n    return fun(x);\n  } else {\n    return result;\n  }\n}\n\n/**\n * Extracts the `Ok` value from a result\x2C returning a default value if the result\n * is an `Error`.\n *\n * ## Examples\n *\n * ```gleam\n * assert unwrap(Ok(1)\x2C 0) == 1\n * ```\n *\n * ```gleam\n * assert unwrap(Error("")\x2C 0) == 0\n * ```\n */\nexport function unwrap(result\x2C default$) {\n  if (result instanceof Ok) {\n    let v = result[0];\n    return v;\n  } else {\n    return default$;\n  }\n}\n\n/**\n * Extracts the `Ok` value from a result\x2C evaluating the default function if the result\n * is an `Error`.\n *\n * ## Examples\n *\n * ```gleam\n * assert lazy_unwrap(Ok(1)\x2C fn() { 0 }) == 1\n * ```\n *\n * ```gleam\n * assert lazy_unwrap(Error("")\x2C fn() { 0 }) == 0\n * ```\n */\nexport function lazy_unwrap(result\x2C default$) {\n  if (result instanceof Ok) {\n    let v = result[0];\n    return v;\n  } else {\n    return default$();\n  }\n}\n\n/**\n * Extracts the `Error` value from a result\x2C returning a default value if the result\n * is an `Ok`.\n *\n * ## Examples\n *\n * ```gleam\n * assert unwrap_error(Error(1)\x2C 0) == 1\n * ```\n *\n * ```gleam\n * assert unwrap_error(Ok("")\x2C 0) == 0\n * ```\n */\nexport function unwrap_error(result\x2C default$) {\n  if (result instanceof Ok) {\n    return default$;\n  } else {\n    let e = result[0];\n    return e;\n  }\n}\n\n/**\n * Returns the first value if it is `Ok`\x2C otherwise returns the second value.\n *\n * ## Examples\n *\n * ```gleam\n * assert or(Ok(1)\x2C Ok(2)) == Ok(1)\n * ```\n *\n * ```gleam\n * assert or(Ok(1)\x2C Error("Error 2")) == Ok(1)\n * ```\n *\n * ```gleam\n * assert or(Error("Error 1")\x2C Ok(2)) == Ok(2)\n * ```\n *\n * ```gleam\n * assert or(Error("Error 1")\x2C Error("Error 2")) == Error("Error 2")\n * ```\n */\nexport function or(first\x2C second) {\n  if (first instanceof Ok) {\n    return first;\n  } else {\n    return second;\n  }\n}\n\n/**\n * Returns the first value if it is `Ok`\x2C otherwise evaluates the given function for a fallback value.\n *\n * If you need access to the initial error value\x2C use `result.try_recover`.\n *\n * ## Examples\n *\n * ```gleam\n * assert lazy_or(Ok(1)\x2C fn() { Ok(2) }) == Ok(1)\n * ```\n *\n * ```gleam\n * assert lazy_or(Ok(1)\x2C fn() { Error("Error 2") }) == Ok(1)\n * ```\n *\n * ```gleam\n * assert lazy_or(Error("Error 1")\x2C fn() { Ok(2) }) == Ok(2)\n * ```\n *\n * ```gleam\n * assert lazy_or(Error("Error 1")\x2C fn() { Error("Error 2") })\n *   == Error("Error 2")\n * ```\n */\nexport function lazy_or(first\x2C second) {\n  if (first instanceof Ok) {\n    return first;\n  } else {\n    return second();\n  }\n}\n\n/**\n * Combines a list of results into a single result.\n * If all elements in the list are `Ok` then returns an `Ok` holding the list of values.\n * If any element is `Error` then returns the first error.\n *\n * ## Examples\n *\n * ```gleam\n * assert all([Ok(1)\x2C Ok(2)]) == Ok([1\x2C 2])\n * ```\n *\n * ```gleam\n * assert all([Ok(1)\x2C Error("e")]) == Error("e")\n * ```\n */\nexport function all(results) {\n  return $list.try_map(results\x2C (result) => { return result; });\n}\n\nfunction partition_loop(loop$results\x2C loop$oks\x2C loop$errors) {\n  while (true) {\n    let results = loop$results;\n    let oks = loop$oks;\n    let errors = loop$errors;\n    if (results instanceof $Empty) {\n      return [oks\x2C errors];\n    } else {\n      let $ = results.head;\n      if ($ instanceof Ok) {\n        let rest = results.tail;\n        let a = $[0];\n        loop$results = rest;\n        loop$oks = listPrepend(a\x2C oks);\n        loop$errors = errors;\n      } else {\n        let rest = results.tail;\n        let e = $[0];\n        loop$results = rest;\n        loop$oks = oks;\n        loop$errors = listPrepend(e\x2C errors);\n      }\n    }\n  }\n}\n\n/**\n * Given a list of results\x2C returns a pair where the first element is a list\n * of all the values inside `Ok` and the second element is a list with all the\n * values inside `Error`. The values in both lists appear in reverse order with\n * respect to their position in the original list of results.\n *\n * ## Examples\n *\n * ```gleam\n * assert partition([Ok(1)\x2C Error("a")\x2C Error("b")\x2C Ok(2)])\n *   == #([2\x2C 1]\x2C ["b"\x2C "a"])\n * ```\n */\nexport function partition(results) {\n  return partition_loop(results\x2C toList([])\x2C toList([]));\n}\n\n/**\n * Replace the value within a result\n *\n * ## Examples\n *\n * ```gleam\n * assert replace(Ok(1)\x2C Nil) == Ok(Nil)\n * ```\n *\n * ```gleam\n * assert replace(Error(1)\x2C Nil) == Error(1)\n * ```\n */\nexport function replace(result\x2C value) {\n  if (result instanceof Ok) {\n    return new Ok(value);\n  } else {\n    return result;\n  }\n}\n\n/**\n * Replace the error within a result\n *\n * ## Examples\n *\n * ```gleam\n * assert replace_error(Error(1)\x2C Nil) == Error(Nil)\n * ```\n *\n * ```gleam\n * assert replace_error(Ok(1)\x2C Nil) == Ok(1)\n * ```\n */\nexport function replace_error(result\x2C error) {\n  if (result instanceof Ok) {\n    return result;\n  } else {\n    return new Error(error);\n  }\n}\n\n/**\n * Given a list of results\x2C returns only the values inside `Ok`.\n *\n * ## Examples\n *\n * ```gleam\n * assert values([Ok(1)\x2C Error("a")\x2C Ok(3)]) == [1\x2C 3]\n * ```\n */\nexport function values(results) {\n  return $list.filter_map(results\x2C (result) => { return result; });\n}\n\n/**\n * Updates a value held within the `Error` of a result by calling a given function\n * on it\x2C where the given function also returns a result. The two results are\n * then merged together into one result.\n *\n * If the result is an `Ok` rather than `Error` the function is not called and the\n * result stays the same.\n *\n * This function is useful for chaining together computations that may fail\n * and trying to recover from possible errors.\n *\n * If you do not need access to the initial error value\x2C use `result.lazy_or`.\n *\n * ## Examples\n *\n * ```gleam\n * assert Ok(1)\n *   |> try_recover(with: fn(_) { Error("failed to recover") })\n *   == Ok(1)\n * ```\n *\n * ```gleam\n * assert Error(1)\n *   |> try_recover(with: fn(error) { Ok(error + 1) })\n *   == Ok(2)\n * ```\n *\n * ```gleam\n * assert Error(1)\n *   |> try_recover(with: fn(error) { Error("failed to recover") })\n *   == Error("failed to recover")\n * ```\n */\nexport function try_recover(result\x2C fun) {\n  if (result instanceof Ok) {\n    return result;\n  } else {\n    let error = result[0];\n    return fun(error);\n  }\n}\n
