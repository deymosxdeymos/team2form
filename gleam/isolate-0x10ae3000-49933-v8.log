script-source,137,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/float.mjs,import { Ok\x2C Error\x2C Empty as $Empty\x2C divideFloat } from "../gleam.mjs";\nimport * as $order from "../gleam/order.mjs";\nimport {\n  parse_float as parse\x2C\n  float_to_string as to_string\x2C\n  ceiling\x2C\n  floor\x2C\n  round as js_round\x2C\n  truncate\x2C\n  identity as do_to_float\x2C\n  power as do_power\x2C\n  random_uniform as random\x2C\n  log as do_log\x2C\n  exp as exponential\x2C\n} from "../gleam_stdlib.mjs";\n\nexport { ceiling\x2C exponential\x2C floor\x2C parse\x2C random\x2C to_string\x2C truncate };\n\n/**\n * Compares two `Float`s\x2C returning an `Order`:\n * `Lt` for lower than\x2C `Eq` for equals\x2C or `Gt` for greater than.\n *\n * ## Examples\n *\n * ```gleam\n * assert compare(2.0\x2C 2.3) == Lt\n * ```\n *\n * To handle\n * [Floating Point Imprecision](https://en.wikipedia.org/wiki/Floating-point_arithmetic#Accuracy_problems)\n * you may use [`loosely_compare`](#loosely_compare) instead.\n */\nexport function compare(a\x2C b) {\n  let $ = a === b;\n  if ($) {\n    return new $order.Eq();\n  } else {\n    let $1 = a < b;\n    if ($1) {\n      return new $order.Lt();\n    } else {\n      return new $order.Gt();\n    }\n  }\n}\n\n/**\n * Compares two `Float`s\x2C returning the smaller of the two.\n *\n * ## Examples\n *\n * ```gleam\n * assert min(2.0\x2C 2.3) == 2.0\n * ```\n */\nexport function min(a\x2C b) {\n  let $ = a < b;\n  if ($) {\n    return a;\n  } else {\n    return b;\n  }\n}\n\n/**\n * Compares two `Float`s\x2C returning the larger of the two.\n *\n * ## Examples\n *\n * ```gleam\n * assert max(2.0\x2C 2.3) == 2.3\n * ```\n */\nexport function max(a\x2C b) {\n  let $ = a > b;\n  if ($) {\n    return a;\n  } else {\n    return b;\n  }\n}\n\n/**\n * Restricts a float between two bounds.\n *\n * Note: If the `min` argument is larger than the `max` argument then they\n * will be swapped\x2C so the minimum bound is always lower than the maximum\n * bound.\n *\n *\n * ## Examples\n *\n * ```gleam\n * assert clamp(1.2\x2C min: 1.4\x2C max: 1.6) == 1.4\n * ```\n *\n * ```gleam\n * assert clamp(1.2\x2C min: 1.4\x2C max: 0.6) == 1.2\n * ```\n */\nexport function clamp(x\x2C min_bound\x2C max_bound) {\n  let $ = min_bound >= max_bound;\n  if ($) {\n    let _pipe = x;\n    let _pipe$1 = min(_pipe\x2C min_bound);\n    return max(_pipe$1\x2C max_bound);\n  } else {\n    let _pipe = x;\n    let _pipe$1 = min(_pipe\x2C max_bound);\n    return max(_pipe$1\x2C min_bound);\n  }\n}\n\n/**\n * Returns the absolute value of the input as a `Float`.\n *\n * ## Examples\n *\n * ```gleam\n * assert absolute_value(-12.5) == 12.5\n * ```\n *\n * ```gleam\n * assert absolute_value(10.2) == 10.2\n * ```\n */\nexport function absolute_value(x) {\n  let $ = x >= 0.0;\n  if ($) {\n    return x;\n  } else {\n    return 0.0 - x;\n  }\n}\n\n/**\n * Compares two `Float`s within a tolerance\x2C returning an `Order`:\n * `Lt` for lower than\x2C `Eq` for equals\x2C or `Gt` for greater than.\n *\n * This function allows Float comparison while handling\n * [Floating Point Imprecision](https://en.wikipedia.org/wiki/Floating-point_arithmetic#Accuracy_problems).\n *\n * Notice: For `Float`s the tolerance won't be exact:\n * `5.3 - 5.0` is not exactly `0.3`.\n *\n * ## Examples\n *\n * ```gleam\n * assert loosely_compare(5.0\x2C with: 5.3\x2C tolerating: 0.5) == Eq\n * ```\n *\n * If you want to check only for equality you may use\n * [`loosely_equals`](#loosely_equals) instead.\n */\nexport function loosely_compare(a\x2C b\x2C tolerance) {\n  let difference = absolute_value(a - b);\n  let $ = difference <= tolerance;\n  if ($) {\n    return new $order.Eq();\n  } else {\n    return compare(a\x2C b);\n  }\n}\n\n/**\n * Checks for equality of two `Float`s within a tolerance\x2C\n * returning a `Bool`.\n *\n * This function allows Float comparison while handling\n * [Floating Point Imprecision](https://en.wikipedia.org/wiki/Floating-point_arithmetic#Accuracy_problems).\n *\n * Notice: For `Float`s the tolerance won't be exact:\n * `5.3 - 5.0` is not exactly `0.3`.\n *\n * ## Examples\n *\n * ```gleam\n * assert loosely_equals(5.0\x2C with: 5.3\x2C tolerating: 0.5)\n * ```\n *\n * ```gleam\n * assert !loosely_equals(5.0\x2C with: 5.1\x2C tolerating: 0.1)\n * ```\n */\nexport function loosely_equals(a\x2C b\x2C tolerance) {\n  let difference = absolute_value(a - b);\n  return difference <= tolerance;\n}\n\n/**\n * Returns the result of the base being raised to the power of the\n * exponent\x2C as a `Float`.\n *\n * ## Examples\n *\n * ```gleam\n * assert power(2.0\x2C -1.0) == Ok(0.5)\n * ```\n *\n * ```gleam\n * assert power(2.0\x2C 2.0) == Ok(4.0)\n * ```\n *\n * ```gleam\n * assert power(8.0\x2C 1.5) == Ok(22.627416997969522)\n * ```\n *\n * ```gleam\n * assert 4.0 |> power(of: 2.0) == Ok(16.0)\n * ```\n *\n * ```gleam\n * assert power(-1.0\x2C 0.5) == Error(Nil)\n * ```\n */\nexport function power(base\x2C exponent) {\n  let fractional = (ceiling(exponent) - exponent) > 0.0;\n  let $ = ((base < 0.0) && fractional) || ((base === 0.0) && (exponent < 0.0));\n  if ($) {\n    return new Error(undefined);\n  } else {\n    return new Ok(do_power(base\x2C exponent));\n  }\n}\n\n/**\n * Returns the square root of the input as a `Float`.\n *\n * ## Examples\n *\n * ```gleam\n * assert square_root(4.0) == Ok(2.0)\n * ```\n *\n * ```gleam\n * assert square_root(-16.0) == Error(Nil)\n * ```\n */\nexport function square_root(x) {\n  return power(x\x2C 0.5);\n}\n\n/**\n * Returns the negative of the value provided.\n *\n * ## Examples\n *\n * ```gleam\n * assert negate(1.0) == -1.0\n * ```\n */\nexport function negate(x) {\n  return -1.0 * x;\n}\n\n/**\n * Rounds the value to the nearest whole number as an `Int`.\n *\n * ## Examples\n *\n * ```gleam\n * assert round(2.3) == 2\n * ```\n *\n * ```gleam\n * assert round(2.5) == 3\n * ```\n */\nexport function round(x) {\n  let $ = x >= 0.0;\n  if ($) {\n    return js_round(x);\n  } else {\n    return 0 - js_round(negate(x));\n  }\n}\n\n/**\n * Converts the value to a given precision as a `Float`.\n * The precision is the number of allowed decimal places.\n * Negative precisions are allowed and force rounding\n * to the nearest tenth\x2C hundredth\x2C thousandth etc.\n *\n * ## Examples\n *\n * ```gleam\n * assert to_precision(2.43434348473\x2C 2) == 2.43\n * ```\n *\n * ```gleam\n * assert to_precision(547890.453444\x2C -3) == 548000.0\n * ```\n */\nexport function to_precision(x\x2C precision) {\n  let $ = precision <= 0;\n  if ($) {\n    let factor = do_power(10.0\x2C do_to_float(- precision));\n    return do_to_float(round(divideFloat(x\x2C factor))) * factor;\n  } else {\n    let factor = do_power(10.0\x2C do_to_float(precision));\n    return divideFloat(do_to_float(round(x * factor))\x2C factor);\n  }\n}\n\nfunction sum_loop(loop$numbers\x2C loop$initial) {\n  while (true) {\n    let numbers = loop$numbers;\n    let initial = loop$initial;\n    if (numbers instanceof $Empty) {\n      return initial;\n    } else {\n      let first = numbers.head;\n      let rest = numbers.tail;\n      loop$numbers = rest;\n      loop$initial = first + initial;\n    }\n  }\n}\n\n/**\n * Sums a list of `Float`s.\n *\n * ## Example\n *\n * ```gleam\n * assert sum([1.0\x2C 2.2\x2C 3.3]) == 6.5\n * ```\n */\nexport function sum(numbers) {\n  return sum_loop(numbers\x2C 0.0);\n}\n\nfunction product_loop(loop$numbers\x2C loop$initial) {\n  while (true) {\n    let numbers = loop$numbers;\n    let initial = loop$initial;\n    if (numbers instanceof $Empty) {\n      return initial;\n    } else {\n      let first = numbers.head;\n      let rest = numbers.tail;\n      loop$numbers = rest;\n      loop$initial = first * initial;\n    }\n  }\n}\n\n/**\n * Multiplies a list of `Float`s and returns the product.\n *\n * ## Example\n *\n * ```gleam\n * assert product([2.5\x2C 3.2\x2C 4.2]) == 33.6\n * ```\n */\nexport function product(numbers) {\n  return product_loop(numbers\x2C 1.0);\n}\n\n/**\n * Computes the modulo of a float division of inputs as a `Result`.\n *\n * Returns division of the inputs as a `Result`: If the given divisor equals\n * `0`\x2C this function returns an `Error`.\n *\n * The computed value will always have the same sign as the `divisor`.\n *\n * ## Examples\n *\n * ```gleam\n * assert modulo(13.3\x2C by: 3.3) == Ok(0.1)\n * ```\n *\n * ```gleam\n * assert modulo(-13.3\x2C by: 3.3) == Ok(3.2)\n * ```\n *\n * ```gleam\n * assert modulo(13.3\x2C by: -3.3) == Ok(-3.2)\n * ```\n *\n * ```gleam\n * assert modulo(-13.3\x2C by: -3.3) == Ok(-0.1)\n * ```\n */\nexport function modulo(dividend\x2C divisor) {\n  if (divisor === 0.0) {\n    return new Error(undefined);\n  } else {\n    return new Ok(dividend - (floor(divideFloat(dividend\x2C divisor)) * divisor));\n  }\n}\n\n/**\n * Returns division of the inputs as a `Result`.\n *\n * ## Examples\n *\n * ```gleam\n * assert divide(0.0\x2C 1.0) == Ok(0.0)\n * ```\n *\n * ```gleam\n * assert divide(1.0\x2C 0.0) == Error(Nil)\n * ```\n */\nexport function divide(a\x2C b) {\n  if (b === 0.0) {\n    return new Error(undefined);\n  } else {\n    let b$1 = b;\n    return new Ok(divideFloat(a\x2C b$1));\n  }\n}\n\n/**\n * Adds two floats together.\n *\n * It's the function equivalent of the `+.` operator.\n * This function is useful in higher order functions or pipes.\n *\n * ## Examples\n *\n * ```gleam\n * assert add(1.0\x2C 2.0) == 3.0\n * ```\n *\n * ```gleam\n * import gleam/list\n *\n * assert list.fold([1.0\x2C 2.0\x2C 3.0]\x2C 0.0\x2C add) == 6.0\n * ```\n *\n * ```gleam\n * assert 3.0 |> add(2.0) == 5.0\n * ```\n */\nexport function add(a\x2C b) {\n  return a + b;\n}\n\n/**\n * Multiplies two floats together.\n *\n * It's the function equivalent of the `*.` operator.\n * This function is useful in higher order functions or pipes.\n *\n * ## Examples\n *\n * ```gleam\n * assert multiply(2.0\x2C 4.0) == 8.0\n * ```\n *\n * ```gleam\n * import gleam/list\n *\n * assert list.fold([2.0\x2C 3.0\x2C 4.0]\x2C 1.0\x2C multiply) == 24.0\n * ```\n *\n * ```gleam\n * assert 3.0 |> multiply(2.0) == 6.0\n * ```\n */\nexport function multiply(a\x2C b) {\n  return a * b;\n}\n\n/**\n * Subtracts one float from another.\n *\n * It's the function equivalent of the `-.` operator.\n * This function is useful in higher order functions or pipes.\n *\n * ## Examples\n *\n * ```gleam\n * assert subtract(3.0\x2C 1.0) == 2.0\n * ```\n *\n * ```gleam\n * import gleam/list\n *\n * assert list.fold([1.0\x2C 2.0\x2C 3.0]\x2C 10.0\x2C subtract) == 4.0\n * ```\n *\n * ```gleam\n * assert 3.0 |> subtract(_\x2C 2.0) == 1.0\n * ```\n *\n * ```gleam\n * assert 3.0 |> subtract(2.0\x2C _) == -1.0\n * ```\n */\nexport function subtract(a\x2C b) {\n  return a - b;\n}\n\n/**\n * Returns the natural logarithm (base e) of the given `Float` as a `Result`. If the\n * input is less than or equal to 0\x2C returns `Error(Nil)`.\n *\n * ## Examples\n *\n * ```gleam\n * assert logarithm(1.0) == Ok(0.0)\n * ```\n *\n * ```gleam\n * assert logarithm(2.718281828459045) == Ok(1.0)\n * ```\n *\n * ```gleam\n * assert logarithm(0.0) == Error(Nil)\n * ```\n *\n * ```gleam\n * assert logarithm(-1.0) == Error(Nil)\n * ```\n */\nexport function logarithm(x) {\n  let $ = x <= 0.0;\n  if ($) {\n    return new Error(undefined);\n  } else {\n    return new Ok(do_log(x));\n  }\n}\n
