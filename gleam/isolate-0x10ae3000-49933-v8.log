script-source,161,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/team2form_gleam/team2form_gleam/weights.mjs,import * as $option from "../../gleam_stdlib/gleam/option.mjs";\nimport { None\x2C Some } from "../../gleam_stdlib/gleam/option.mjs";\nimport { CustomType as $CustomType\x2C divideFloat } from "../gleam.mjs";\nimport * as $modes from "../team2form_gleam/modes.mjs";\nimport { Compat\x2C DocsRecommended\x2C LiveCompat\x2C Paper\x2C PaperBalanced } from "../team2form_gleam/modes.mjs";\n\nexport class Weights extends $CustomType {\n  constructor(alpha\x2C beta\x2C gamma\x2C delta) {\n    super();\n    this.alpha = alpha;\n    this.beta = beta;\n    this.gamma = gamma;\n    this.delta = delta;\n  }\n}\nexport const Weights$Weights = (alpha\x2C beta\x2C gamma\x2C delta) =>\n  new Weights(alpha\x2C beta\x2C gamma\x2C delta);\nexport const Weights$isWeights = (value) => value instanceof Weights;\nexport const Weights$Weights$alpha = (value) => value.alpha;\nexport const Weights$Weights$0 = (value) => value.alpha;\nexport const Weights$Weights$beta = (value) => value.beta;\nexport const Weights$Weights$1 = (value) => value.beta;\nexport const Weights$Weights$gamma = (value) => value.gamma;\nexport const Weights$Weights$2 = (value) => value.gamma;\nexport const Weights$Weights$delta = (value) => value.delta;\nexport const Weights$Weights$3 = (value) => value.delta;\n\nexport function total(weights) {\n  return ((weights.alpha + weights.beta) + weights.gamma) + weights.delta;\n}\n\nexport function normalized(weights) {\n  let all = total(weights);\n  let $ = all <= 0.0;\n  if ($) {\n    return weights;\n  } else {\n    return new Weights(\n      divideFloat(weights.alpha\x2C all)\x2C\n      divideFloat(weights.beta\x2C all)\x2C\n      divideFloat(weights.gamma\x2C all)\x2C\n      divideFloat(weights.delta\x2C all)\x2C\n    );\n  }\n}\n\nexport function preset_weights(preset) {\n  if (preset instanceof LiveCompat) {\n    return new Weights(0.3\x2C 0.3