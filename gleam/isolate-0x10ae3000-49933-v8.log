script-source,136,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/dict.mjs,/**\n * This file uses jsdoc to annotate types.\n * These types can be checked using the typescript compiler with "checkjs" option.\n */\n\nimport { isEqual\x2C Result$Error\x2C Result$Ok } from "./gleam.mjs";\n\n// -- HASH --------------------------------------------------------------------\n\nconst referenceMap = /* @__PURE__ */ new WeakMap();\nconst tempDataView = /* @__PURE__ */ new DataView(\n  /* @__PURE__ */ new ArrayBuffer(8)\x2C\n);\nlet referenceUID = 0;\n/**\n * hash the object by reference using a weak map and incrementing uid\n * @param {any} o\n * @returns {number}\n */\nfunction hashByReference(o) {\n  const known = referenceMap.get(o);\n  if (known !== undefined) {\n    return known;\n  }\n  const hash = referenceUID++;\n  if (referenceUID === 0x7fffffff) {\n    referenceUID = 0;\n  }\n  referenceMap.set(o\x2C hash);\n  return hash;\n}\n\n/**\n * merge two hashes in an order sensitive way\n * @param {number} a\n * @param {number} b\n * @returns {number}\n */\nfunction hashMerge(a\x2C b) {\n  return (a ^ (b + 0x9e3779b9 + (a << 6) + (a >> 2))) | 0;\n}\n\n/**\n * standard string hash popularised by Java\n * @param {string} s\n * @returns {number}\n */\nfunction hashString(s) {\n  let hash = 0;\n  const len = s.length;\n  for (let i = 0; i < len; i++) {\n    hash = (Math.imul(31\x2C hash) + s.charCodeAt(i)) | 0;\n  }\n  return hash;\n}\n\n/**\n * hash a number by converting to two integers and do some jumbling\n * @param {number} n\n * @returns {number}\n */\nfunction hashNumber(n) {\n  tempDataView.setFloat64(0\x2C n);\n  const i = tempDataView.getInt32(0);\n  const j = tempDataView.getInt32(4);\n  return Math.imul(0x45d9f3b\x2C (i >> 16) ^ i) ^ j;\n}\n\n/**\n * hash a BigInt by converting it to a string and hashing that\n * @param {BigInt} n\n * @returns {number}\n */\nfunction hashBigInt(n) {\n  return hashString(n.toString());\n}\n\n/**\n * has