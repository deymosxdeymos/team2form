script-source,153,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/set.mjs,import { CustomType as $CustomType\x2C isEqual } from "../gleam.mjs";\nimport * as $dict from "../gleam/dict.mjs";\nimport * as $list from "../gleam/list.mjs";\nimport * as $result from "../gleam/result.mjs";\n\nclass Set extends $CustomType {\n  constructor(dict) {\n    super();\n    this.dict = dict;\n  }\n}\n\nconst token = undefined;\n\n/**\n * Creates a new empty set.\n */\nexport function new$() {\n  return new Set($dict.new$());\n}\n\n/**\n * Gets the number of members in a set.\n *\n * This function runs in constant time.\n *\n * ## Examples\n *\n * ```gleam\n * assert new()\n *   |> insert(1)\n *   |> insert(2)\n *   |> size\n *   == 2\n * ```\n */\nexport function size(set) {\n  return $dict.size(set.dict);\n}\n\n/**\n * Determines whether or not the set is empty.\n *\n * ## Examples\n *\n * ```gleam\n * assert new() |> is_empty\n * ```\n *\n * ```gleam\n * assert !{ new() |> insert(1) |> is_empty }\n * ```\n */\nexport function is_empty(set) {\n  return isEqual(set\x2C new$());\n}\n\n/**\n * Checks whether a set contains a given member.\n *\n * This function runs in logarithmic time.\n *\n * ## Examples\n *\n * ```gleam\n * assert new()\n *   |> insert(2)\n *   |> contains(2)\n * ```\n *\n * ```gleam\n * assert !{\n *   new()\n *   |> insert(2)\n *   |> contains(1)\n * }\n * ```\n */\nexport function contains(set\x2C member) {\n  let _pipe = set.dict;\n  let _pipe$1 = $dict.get(_pipe\x2C member);\n  return $result.is_ok(_pipe$1);\n}\n\n/**\n * Removes a member from a set. If the set does not contain the member then\n * the set is returned unchanged.\n *\n * This function runs in logarithmic time.\n *\n * ## Examples\n *\n * ```gleam\n * assert !{\n *   new()\n *   |> insert(2)\n *   |> delete(2)\n *   |> contains(2)\n * }\n * ```\n */\nexport function delete$(set\x2C member) {\n  return new Set($dict.delete$(set.dict\x2C member));\n}\n\n/**\n * Converts the set into a list of the contained members.\n *\n * The list has no specific ordering\x2C any unintentional ordering may change in\n * future versions of Gleam or Erlang.\n *\n * This function runs in linear time.\n *\n * ## Examples\n *\n * ```gleam\n * assert new() |> insert(2) |> to_list == [2]\n * ```\n */\nexport function to_list(set) {\n  return $dict.keys(set.dict);\n}\n\n/**\n * Combines all entries into a single value by calling a given function on each\n * one.\n *\n * Sets are not ordered so the values are not returned in any specific order.\n * Do not write code that relies on the order entries are used by this\n * function as it may change in later versions of Gleam or Erlang.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([1\x2C 3\x2C 9])\n *   |> fold(0\x2C fn(accumulator\x2C member) { accumulator + member })\n *   == 13\n * ```\n */\nexport function fold(set\x2C initial\x2C reducer) {\n  return $dict.fold(set.dict\x2C initial\x2C (a\x2C k\x2C _) => { return reducer(a\x2C k); });\n}\n\n/**\n * Creates a new set from an existing set\x2C minus any members that a given\n * function returns `False` for.\n *\n * This function runs in loglinear time.\n *\n * ## Examples\n *\n * ```gleam\n * import gleam/int\n *\n * assert from_list([1\x2C 4\x2C 6\x2C 3\x2C 675\x2C 44\x2C 67])\n *   |> filter(keeping: int.is_even)\n *   |> to_list\n *   == [4\x2C 6\x2C 44]\n * ```\n */\nexport function filter(set\x2C predicate) {\n  return new Set($dict.filter(set.dict\x2C (m\x2C _) => { return predicate(m); }));\n}\n\n/**\n * Creates a new set from a given set with all the same entries except any\n * entry found on the given list.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([1\x2C 2\x2C 3\x2C 4])\n *   |> drop([1\x2C 3])\n *   |> to_list\n *   == [2\x2C 4]\n * ```\n */\nexport function drop(set\x2C disallowed) {\n  return $list.fold(disallowed\x2C set\x2C delete$);\n}\n\n/**\n * Creates a new set from a given set\x2C only including any members which are in\n * a given list.\n *\n * This function runs in loglinear time.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([1\x2C 2\x2C 3])\n *   |> take([1\x2C 3\x2C 5])\n *   |> to_list\n *   == [1\x2C 3]\n * ```\n */\nexport function take(set\x2C desired) {\n  return new Set($dict.take(set.dict\x2C desired));\n}\n\nfunction order(first\x2C second) {\n  let $ = $dict.size(first.dict) > $dict.size(second.dict);\n  if ($) {\n    return [first\x2C second];\n  } else {\n    return [second\x2C first];\n  }\n}\n\n/**\n * Creates a new set that contains members that are present in both given sets.\n *\n * This function runs in loglinear time.\n *\n * ## Examples\n *\n * ```gleam\n * assert intersection(from_list([1\x2C 2])\x2C from_list([2\x2C 3])) |> to_list\n *   == [2]\n * ```\n */\nexport function intersection(first\x2C second) {\n  let $ = order(first\x2C second);\n  let larger;\n  let smaller;\n  larger = $[0];\n  smaller = $[1];\n  return take(larger\x2C to_list(smaller));\n}\n\n/**\n * Creates a new set that contains members that are present in the first set\n * but not the second.\n *\n * ## Examples\n *\n * ```gleam\n * assert difference(from_list([1\x2C 2])\x2C from_list([2\x2C 3\x2C 4])) |> to_list\n *   == [1]\n * ```\n */\nexport function difference(first\x2C second) {\n  return drop(first\x2C to_list(second));\n}\n\n/**\n * Determines if a set is fully contained by another.\n *\n * ## Examples\n *\n * ```gleam\n * assert is_subset(from_list([1])\x2C from_list([1\x2C 2]))\n * ```\n *\n * ```gleam\n * assert !is_subset(from_list([1\x2C 2\x2C 3])\x2C from_list([3\x2C 4\x2C 5]))\n * ```\n */\nexport function is_subset(first\x2C second) {\n  return isEqual(intersection(first\x2C second)\x2C first);\n}\n\n/**\n * Determines if two sets contain no common members\n *\n * ## Examples\n *\n * ```gleam\n * assert is_disjoint(from_list([1\x2C 2\x2C 3])\x2C from_list([4\x2C 5\x2C 6]))\n * ```\n *\n * ```gleam\n * assert !is_disjoint(from_list([1\x2C 2\x2C 3])\x2C from_list([3\x2C 4\x2C 5]))\n * ```\n */\nexport function is_disjoint(first\x2C second) {\n  return isEqual(intersection(first\x2C second)\x2C new$());\n}\n\n/**\n * Calls a function for each member in a set\x2C discarding the return\n * value.\n *\n * Useful for producing a side effect for every item of a set.\n *\n * The order of elements in the iteration is an implementation detail that\n * should not be relied upon.\n *\n * ## Examples\n *\n * ```gleam\n * let set = from_list(["apple"\x2C "banana"\x2C "cherry"])\n *\n * assert each(set\x2C io.println) == Nil\n * // apple\n * // banana\n * // cherry\n * ```\n */\nexport function each(set\x2C fun) {\n  return fold(\n    set\x2C\n    undefined\x2C\n    (nil\x2C member) => {\n      fun(member);\n      return nil;\n    }\x2C\n  );\n}\n\n/**\n * Inserts a member into the set.\n *\n * This function runs in logarithmic time.\n *\n * ## Examples\n *\n * ```gleam\n * assert new()\n *   |> insert(1)\n *   |> insert(2)\n *   |> size\n *   == 2\n * ```\n */\nexport function insert(set\x2C member) {\n  return new Set($dict.insert(set.dict\x2C member\x2C token));\n}\n\n/**\n * Creates a new set of the members in a given list.\n *\n * This function runs in loglinear time.\n *\n * ## Examples\n *\n * ```gleam\n * import gleam/int\n * import gleam/list\n *\n * assert [1\x2C 1\x2C 2\x2C 4\x2C 3\x2C 2]\n *   |> from_list\n *   |> to_list\n *   |> list.sort(by: int.compare)\n *   == [1\x2C 2\x2C 3\x2C 4]\n * ```\n */\nexport function from_list(members) {\n  let dict = $list.fold(\n    members\x2C\n    $dict.new$()\x2C\n    (m\x2C k) => { return $dict.insert(m\x2C k\x2C token); }\x2C\n  );\n  return new Set(dict);\n}\n\n/**\n * Creates a new set from a given set with the result of applying the given\n * function to each member.\n *\n * ## Examples\n *\n * ```gleam\n * assert from_list([1\x2C 2\x2C 3\x2C 4])\n *   |> map(with: fn(x) { x * 2 })\n *   |> to_list\n *   == [2\x2C 4\x2C 6\x2C 8]\n * ```\n */\nexport function map(set\x2C fun) {\n  return fold(\n    set\x2C\n    new$()\x2C\n    (acc\x2C member) => { return insert(acc\x2C fun(member)); }\x2C\n  );\n}\n\n/**\n * Creates a new set that contains all members of both given sets.\n *\n * This function runs in loglinear time.\n *\n * ## Examples\n *\n * ```gleam\n * assert union(from_list([1\x2C 2])\x2C from_list([2\x2C 3])) |> to_list\n *   == [1\x2C 2\x2C 3]\n * ```\n */\nexport function union(first\x2C second) {\n  let $ = order(first\x2C second);\n  let larger;\n  let smaller;\n  larger = $[0];\n  smaller = $[1];\n  return fold(smaller\x2C larger\x2C insert);\n}\n\n/**\n * Creates a new set that contains members that are present in either set\x2C but\n * not both.\n *\n * ## Examples\n *\n * ```gleam\n * assert symmetric_difference(from_list([1\x2C 2\x2C 3])\x2C from_list([3\x2C 4]))\n *   |> to_list\n *   == [1\x2C 2\x2C 4]\n * ```\n */\nexport function symmetric_difference(first\x2C second) {\n  return difference(union(first\x2C second)\x2C intersection(first\x2C second));\n}\n
