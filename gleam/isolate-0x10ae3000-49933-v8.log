              );\n            } else {\n              return new Error(new DuplicateTaskIds(duplicate_tasks));\n            }\n          } else {\n            return new Error(new DuplicatePersonIds(duplicate_people));\n          }\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction prepend_unknown_preference_id(found\x2C preference\x2C member_ids) {\n  let $ = $set.contains(member_ids\x2C preference.person_id);\n  if ($) {\n    return found;\n  } else {\n    return listPrepend(preference.person_id\x2C found);\n  }\n}\n\nfunction validate_member_preferences(member_id\x2C preferences\x2C member_ids) {\n  if (preferences instanceof Some) {\n    let $ = preferences[0];\n    if ($ instanceof $Empty) {\n      return new Ok(undefined);\n    } else {\n      let $1 = $.tail;\n      if ($1 instanceof $Empty) {\n        let first = $.head;\n        let $2 = $set.contains(member_ids\x2C first.person_id);\n        if ($2) {\n          return new Ok(undefined);\n        } else {\n          return new Error(\n            new UnknownPersonPreferencePersonIds(\n              member_id\x2C\n              toList([first.person_id])\x2C\n            )\x2C\n          );\n        }\n      } else {\n        let $2 = $1.tail;\n        if ($2 instanceof $Empty) {\n          let first = $.head;\n          let second = $1.head;\n          let $3 = first.person_id === second.person_id;\n          if ($3) {\n            return new Error(\n              new DuplicatePersonPreferenceIds(\n                member_id\x2C\n                toList([first.person_id])\x2C\n              )\x2C\n            );\n          } else {\n            let _block;\n            let _pipe = toList([]);\n            let _pipe$1 = prepend_unknown_preference_id(\n              _pipe\x2C\n              first\x2C\n              member_ids\x2C\n            );\n            let _pipe$2 = prepend_unknown_preference_id(\n              _pipe$1\x2C\n              second\x2C\n              member_ids\x2C\n            );\n            let _pipe$3 = $list.reverse(_pipe$2);\n            _block = $list.sort(_pipe$3\x2C $string.compare);\n            let unknown_preferences = _block;\n            if (unknown_preferences instanceof $Empty) {\n              return new Ok(undefined);\n            } else {\n              return new Error(\n                new UnknownPersonPreferencePersonIds(\n                  member_id\x2C\n                  unknown_preferences\x2C\n                )\x2C\n              );\n            }\n          }\n        } else {\n          let duplicate_preferences = duplicate_person_preference_person_ids(\n            preferences\x2C\n          );\n          if (duplicate_preferences instanceof $Empty) {\n            let unknown_preferences = unknown_person_preference_person_ids(\n              preferences\x2C\n              member_ids\x2C\n            );\n            if (unknown_preferences instanceof $Empty) {\n              return new Ok(undefined);\n            } else {\n              return new Error(\n                new UnknownPersonPreferencePersonIds(\n                  member_id\x2C\n                  unknown_preferences\x2C\n                )\x2C\n              );\n            }\n          } else {\n            return new Error(\n              new DuplicatePersonPreferenceIds(member_id\x2C duplicate_preferences)\x2C\n            );\n          }\n        }\n      }\n    }\n  } else {\n    return new Ok(undefined);\n  }\n}\n\nfunction validate_team_members(team\x2C member_ids) {\n  return $list.fold(\n    team\x2C\n    new Ok(undefined)\x2C\n    (current\x2C member) => {\n      return $result.try$(\n        current\x2C\n        (_use0) => {\n          \n          return validate_member_preferences(\n            member.id\x2C\n            member.preferences\x2C\n            member_ids\x2C\n          );\n        }\x2C\n      );\n    }\x2C\n  );\n}\n\nexport function validate_team_quality_request(request) {\n  let team;\n  team = request.team;\n  let duplicate_members = duplicate_ids(\n    $list.map(team\x2C (member) => { return member.id; })\x2C\n  );\n  if (duplicate_members instanceof $Empty) {\n    let member_ids = $set.from_list(\n      $list.map(team\x2C (member) => { return member.id; })\x2C\n    );\n    return $result.try$(\n      validate_team_members(team\x2C member_ids)\x2C\n      (_use0) => {\n        \n        return new Ok(request);\n      }\x2C\n    );\n  } else {\n    return new Error(new DuplicateTeamMemberIds(duplicate_members));\n  }\n}\n\nexport function validation_error_to_string(error) {\n  if (error instanceof DuplicatePersonIds) {\n    let ids = error[0];\n    return "people ids must be unique: " + $string.join(ids\x2C "\x2C ");\n  } else if (error instanceof DuplicateTaskIds) {\n    let ids = error[0];\n    return "task ids must be unique: " + $string.join(ids\x2C "\x2C ");\n  } else if (error instanceof DuplicateTeamMemberIds) {\n    let ids = error[0];\n    return "team member ids must be unique: " + $string.join(ids\x2C "\x2C ");\n  } else if (error instanceof DuplicatePersonPreferenceIds) {\n    let person_id = error.person_id;\n    let person_ids = error.person_ids;\n    return (("person preferences must not contain duplicate personIds for " + person_id) + ": ") + $string.join(\n      person_ids\x2C\n      "\x2C "\x2C\n    );\n  } else if (error instanceof DuplicateTaskPreferenceIds) {\n    let task_id = error.task_id;\n    let person_ids = error.person_ids;\n    return (("task preferences must not contain duplicate personIds for " + task_id) + ": ") + $string.join(\n      person_ids\x2C\n      "\x2C "\x2C\n    );\n  } else if (error instanceof UnknownPersonPreferencePersonIds) {\n    let person_id = error.person_id;\n    let person_ids = error.person_ids;\n    return (("person preferences reference unknown people ids for " + person_id) + ": ") + $string.join(\n      person_ids\x2C\n      "\x2C "\x2C\n    );\n  } else {\n    let task_id = error.task_id;\n    let person_ids = error.person_ids;\n    return (("task preferences reference unknown people ids for " + task_id) + ": ") + $string.join(\n      person_ids\x2C\n      "\x2C "\x2C\n    );\n  }\n}\n
