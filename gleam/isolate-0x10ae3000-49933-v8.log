script-source,140,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/gleam_stdlib/gleam/dynamic.mjs,import * as $dict from "../gleam/dict.mjs";\nimport {\n  classify_dynamic as classify\x2C\n  identity as bool\x2C\n  identity as string\x2C\n  identity as float\x2C\n  identity as int\x2C\n  identity as bit_array\x2C\n  identity as list\x2C\n  list_to_array as array\x2C\n  identity as cast\x2C\n} from "../gleam_stdlib.mjs";\n\nexport { array\x2C bit_array\x2C bool\x2C classify\x2C float\x2C int\x2C list\x2C string };\n\n/**\n * Create a dynamic value made of an unordered series of keys and values\x2C where\n * the keys are unique.\n *\n * On Erlang this will be a map\x2C on JavaScript this will be a Gleam dict\n * object.\n */\nexport function properties(entries) {\n  return cast($dict.from_list(entries));\n}\n\n/**\n * A dynamic value representing nothing.\n *\n * On Erlang this will be the atom `nil`\x2C on JavaScript this will be\n * `undefined`.\n */\nexport function nil() {\n  return cast(undefined);\n}\n
