ew Data Node\n  // No child node and no data node exists yet\x2C so we can potentially just insert a new value.\n  const dataidx = Math.imul(index(node.datamap\x2C bit)\x2C 2);\n  if ((node.datamap & bit) === 0) {\n    transient.size += 1;\n    return copyAndInsertPair(node\x2C generation\x2C bit\x2C dataidx\x2C key\x2C value);\n  }\n\n  // 4. Existing Data Node\n  // We have a match that we can update\x2C or remove.\n  if (isEqual(key\x2C data[dataidx])) {\n    return copyAndSet(node\x2C generation\x2C dataidx + 1\x2C value);\n  }\n\n  // 5. Collision\n  // There is no child node\x2C but a data node with the same hash\x2C but with a different key.\n  // To resolve this\x2C we push both nodes down one level.\n  const childShift = shift + bits;\n\n  let child = emptyNode;\n  child = insertIntoNode(transient\x2C child\x2C key\x2C value\x2C hash\x2C childShift);\n\n  const key2 = data[dataidx];\n  const value2 = data[dataidx + 1];\n  const hash2 = getHash(key2);\n  child = insertIntoNode(transient\x2C child\x2C key2\x2C value2\x2C hash2\x2C childShift);\n\n  // we inserted 2 elements\x2C but implicitely deleted the one we pushed down from the datamap.\n  transient.size -= 1;\n\n  // remove the old data pair\x2C and insert the new child node.\n  const length = data.length;\n  const nodeidx = length - 1 - index(node.nodemap\x2C bit);\n\n  // writing these loops in javascript instead of a combination of splices\n  // turns out to be faster. Copying always turned out to be faster.\n  const newData = new Array(length - 1);\n\n  let readIndex = 0;\n  let writeIndex = 0;\n\n  // [0..dataidx\x2C skip 2 elements\x2C ..nodeidx\x2C newChild\x2C ..rest]\n  while (readIndex < dataidx) newData[writeIndex++] = data[readIndex++];\n  readIndex += 2;\n  while (readIndex <= nodeidx) newData[writeIndex++] = data[readIndex++];\n  newData[writeIndex++] = child;\n  while (readIndex < length) newData[writeIndex++] = data[readIndex++];\n\n  return makeNode(generation\x2C node.datamap ^ bit\x2C node.nodemap | bit\x2C newData);\n}\n\n/**\n * Consume a transient\x2C removing a key if it exists.\n * Returns a new transient.\n */\nexport function destructiveTransientDelete(key\x2C transient) {\n  const hash = getHash(key);\n  transient.root = deleteFromNode(transient\x2C transient.root\x2C key\x2C hash\x2C 0);\n  return transient;\n}\n\nfunction deleteFromNode(transient\x2C node\x2C key\x2C hash\x2C shift) {\n  const data = node.data;\n  const generation = transient.generation;\n\n  // 1. Overflow Node\n  // overflow nodes only contain key/value-pairs. we walk the data linearly trying to find a match.\n  if (shift > 32) {\n    for (let i = 0; i < data.length; i += 2) {\n      if (isEqual(key\x2C data[i])) {\n        transient.size -= 1;\n        return copyAndRemovePair(node\x2C generation\x2C 0\x2C i);\n      }\n    }\n\n    return node;\n  }\n\n  const bit = hashbit(hash\x2C shift);\n  const dataidx = Math.imul(index(node.datamap\x2C bit)\x2C 2);\n\n  // 2. Child Node\n  // We have to check first if there is already a child node we have to traverse to.\n  if ((node.nodemap & bit) !== 0) {\n    const nodeidx = data.length - 1 - index(node.nodemap\x2C bit);\n\n    let child = data[nodeidx];\n    child = deleteFromNode(transient\x2C child\x2C key\x2C hash\x2C shift + bits);\n\n    // the node did change\x2C so let's copy to incorporate that change.\n    if (child.nodemap !== 0 || child.data.length > 2) {\n      return copyAndSet(node\x2C generation\x2C nodeidx\x2C child);\n    }\n\n    // this node only has a single data (k/v-pair) child.\n    // to restore the CHAMP invariant\x2C we "pull" that pair up into ourselves.\n    // this ensures that every tree stays in its single optimal representation\x2C\n    // and allows dicts to be structurally compared.\n    const length = data.length;\n    const newData = new Array(length + 1);\n\n    let readIndex = 0;\n    let writeIndex = 0;\n\n    while (readIndex < dataidx) newData[writeIndex++] = data[readIndex++];\n    newData[writeIndex++] = child.data[0];\n    newData[writeIndex++] = child.data[1];\n    while (readIndex < nodeidx) newData[writeIndex++] = data[readIndex++];\n    readIndex++;\n    while (readIndex < length) newData[writeIndex++] = data[readIndex++];\n\n    return makeNode(generation\x2C node.datamap | bit\x2C node.nodemap ^ bit\x2C newData);\n  }\n\n  // 3. Data Node\n  // There is no data entry here\x2C or it is a prefix for a different key\n  if ((node.datamap & bit) === 0 || !isEqual(key\x2C data[dataidx])) {\n    return node;\n  }\n\n  // we found a data entry that we can delete.\n  transient.size -= 1;\n  return copyAndRemovePair(node\x2C generation\x2C bit\x2C dataidx);\n}\n\nexport function map(dict\x2C fun) {\n  // map can never modify the structure\x2C so we can walk the dictionary directly\x2C\n  // but still move to a new generation to make sure we get a new copy of every node.\n  const generation = nextGeneration(dict);\n  const root = copyNode(dict.root\x2C generation);\n  const queue = [root];\n\n  while (queue.length) {\n    // order doesn't matter\x2C so we can use push/pop for faster array usage.\n    const node = queue.pop();\n    const data = node.data;\n    // every node contains popcount(datamap) direct entries\n    // We need to query the length from the nodemap\x2C as we don't know if this\n    //  is an overflow node or not! if it is\x2C it will never have datamap set!\n    const edgesStart = data.length - popcount(node.nodemap);\n    for (let i = 0; i < edgesStart; i += 2) {\n      // we copied the node while queueing it\x2C so direct mutation here is safe.\n      data[i + 1] = fun(data[i]\x2C data[i + 1]);\n    }\n    // the remaining entries are other nodes we can queue\n    for (let i = edgesStart; i < data.length; ++i) {\n      // copy the node first to make it safe to mutate\n      data[i] = copyNode(data[i]\x2C generation);\n      queue.push(data[i]);\n    }\n  }\n\n  return new Dict(dict.size\x2C root);\n}\n\nexport function fold(dict\x2C state\x2C fun) {\n  const queue = [dict.root];\n\n  while (queue.length) {\n    // order doesn't matter\x2C so we can use push/pop for faster array usage.\n    const node = queue.pop();\n    const data = node.data;\n    // every node contains popcount(datamap) direct entries\n    // We need to query the length from the nodemap\x2C as we don't know if this\n    //  is an overflow node or not! if it is\x2C it will never have datamap set!\n    const edgesStart = data.length - popcount(node.nodemap);\n    for (let i = 0; i < edgesStart; i += 2) {\n      state = fun(state\x2C data[i]\x2C data[i + 1]);\n    }\n    // the remaining entries are child nodes we can queue.\n    for (let i = edgesStart; i < data.length; ++i) {\n      queue.push(data[i]);\n    }\n  }\n\n  return state;\n}\n\n/**\n * How many `1` bits are set in a 32-bit integer.\n */\nfunction popcount(n) {\n  n -= (n >>> 1) & 0x55555555;\n  n = (n & 0x33333333) + ((n >>> 2) & 0x33333333);\n  return Math.imul((n + (n >>> 4)) & 0x0f0f0f0f\x2C 0x01010101) >>> 24;\n}\n\n/**\n * Given a population bitmap and a bit selected from that map\x2C returns\n * how many less significant 1 bits there are.\n *\n * For example\x2C index(10101\x2C 100) returns 1\x2C since there is a single less\n * significant `1` bit. This translates to the 0-based "index" of that bit.\n */\nfunction index(bitmap\x2C bit) {\n  return popcount(bitmap & (bit - 1));\n}\n\n/**\n * Extracts a single slice of the hash\x2C and returns a bitmask for the resulting value.\n * For example\x2C if the slice returns 5\x2C this function returns 10000 = 1 << 5.\n */\nfunction hashbit(hash\x2C shift) {\n  return 1 << ((hash >>> shift) & mask);\n}\n
