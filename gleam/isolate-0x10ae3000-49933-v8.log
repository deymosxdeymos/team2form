script-source,129,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/team2form_gleam/team2form_gleam.mjs,import * as $option from "../gleam_stdlib/gleam/option.mjs";\nimport { None\x2C Some } from "../gleam_stdlib/gleam/option.mjs";\nimport * as $result from "../gleam_stdlib/gleam/result.mjs";\nimport { Ok } from "./gleam.mjs";\nimport * as $codec from "./team2form_gleam/codec.mjs";\nimport * as $formation from "./team2form_gleam/formation.mjs";\nimport * as $modes from "./team2form_gleam/modes.mjs";\nimport * as $scoring from "./team2form_gleam/scoring.mjs";\n\nexport function help_info() {\n  return $codec.encode_help_info();\n}\n\nexport function quality_from_json_with_mode_preset(\n  input_json\x2C\n  mode\x2C\n  preset\x2C\n  normalize_weights\n) {\n  return $result.try$(\n    $codec.decode_team_quality_request(input_json)\x2C\n    (request) => {\n      let quality = $scoring.calculate_team_quality(\n        request\x2C\n        mode\x2C\n        preset\x2C\n        normalize_weights\x2C\n        new None()\x2C\n        new None()\x2C\n      );\n      return new Ok($codec.encode_quality_breakdown(quality));\n    }\x2C\n  );\n}\n\nexport function form_from_json_with_mode_preset(\n  input_json\x2C\n  mode\x2C\n  preset\x2C\n  normalize_weights\x2C\n  max_candidate_teams\n) {\n  return $result.try$(\n    $codec.decode_formation_request(input_json)\x2C\n    (request) => {\n      return $result.try$(\n        (() => {\n          let _pipe = $formation.form_teams(\n            request\x2C\n            mode\x2C\n            preset\x2C\n            normalize_weights\x2C\n            max_candidate_teams\x2C\n          );\n          return $result.map_error(\n            _pipe\x2C\n            $formation.team_formation_error_to_string\x2C\n          );\n        })()\x2C\n        (response) => { return new Ok($codec.encode_teams_response(response)); }\x2C\n      );\n    }\x2C\n  );\n}\n\nfunction parse_preset(name) {\n  if (name instanceof Some) {\n    let