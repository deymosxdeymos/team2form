script-source,158,file:///home/deymos/Documents/team2form/gleam/build/dev/javascript/team2form_gleam/team2form_gleam/scoring.mjs,import * as $dict from "../../gleam_stdlib/gleam/dict.mjs";\nimport * as $float from "../../gleam_stdlib/gleam/float.mjs";\nimport * as $int from "../../gleam_stdlib/gleam/int.mjs";\nimport * as $list from "../../gleam_stdlib/gleam/list.mjs";\nimport * as $option from "../../gleam_stdlib/gleam/option.mjs";\nimport { None\x2C Some } from "../../gleam_stdlib/gleam/option.mjs";\nimport * as $set from "../../gleam_stdlib/gleam/set.mjs";\nimport {\n  Ok\x2C\n  toList\x2C\n  Empty as $Empty\x2C\n  prepend as listPrepend\x2C\n  CustomType as $CustomType\x2C\n  divideFloat\x2C\n  isEqual\x2C\n} from "../gleam.mjs";\nimport * as $math from "../team2form_gleam/math.mjs";\nimport * as $models from "../team2form_gleam/models.mjs";\nimport {\n  AssignedPerson\x2C\n  Female\x2C\n  Male\x2C\n  QualityBreakdown\x2C\n  TeamMember\x2C\n  TeamQualityRequest\x2C\n  team_member_to_person\x2C\n} from "../team2form_gleam/models.mjs";\nimport * as $modes from "../team2form_gleam/modes.mjs";\nimport { Compat\x2C Paper } from "../team2form_gleam/modes.mjs";\nimport * as $weights from "../team2form_gleam/weights.mjs";\nimport { resolve_weights } from "../team2form_gleam/weights.mjs";\n\nexport class AssignmentResult extends $CustomType {\n  constructor(assignments\x2C skill_score) {\n    super();\n    this.assignments = assignments;\n    this.skill_score = skill_score;\n  }\n}\nexport const AssignmentResult$AssignmentResult = (assignments\x2C skill_score) =>\n  new AssignmentResult(assignments\x2C skill_score);\nexport const AssignmentResult$isAssignmentResult = (value) =>\n  value instanceof AssignmentResult;\nexport const AssignmentResult$AssignmentResult$assignments = (value) =>\n  value.assignments;\nexport const AssignmentResult$AssignmentResult$0 = (value) => value.assignments;\nexport const AssignmentResult$AssignmentResult$skill_score = (value) =>\n  value.s